        const result = downloadText(fileName, code, "text/javascript");
        if (result === "picker") {
          notify("success", "已打开保存位置，选好后即可保存");
          return;
        }
        notify(result ? "success" : "error", result ? downloadSavedText(fileName) : "下载失败，请用「复制源码」");
      });
      const copyBtn = element("button", "pmt-action pmt-copy-export", "复制源码");
      copyBtn.type = "button";
      copyBtn.addEventListener("click", () => {
        copyText(code)
          .then(() => notify("success", "已复制插件源码"))
          .catch(() => notify("error", "复制失败，请长按文本框全选复制"));
      });
      actions.appendChild(downloadBtn);
      actions.appendChild(copyBtn);
      body.appendChild(actions);

      const area = doc.createElement("textarea");
      area.className = "pmt-input pmt-code pmt-export-code";
      area.value = code;
      area.readOnly = true;
      area.setAttribute("aria-label", "插件源码");
      area.addEventListener("focus", () => {
        try { area.select(); } catch (err) { /* ignore */ }
      });
      body.appendChild(area);

      body.appendChild(element("p", "pmt-tip", "同 id 的插件可以用「导入」覆盖升级，原有设置会保留。"));
    }

    function buildExportBundle(list) {
      const source = Array.isArray(list) ? list : plugins;
      const payload = {
        format: "doremy-chat-plugins",
        version: 1,
        exportedAt: new Date().toISOString(),
        plugins: source.map((plugin) => ({
          manifest: plugin.manifest,
          enabled: plugin.enabled !== false,
          settings: plugin.settings && typeof plugin.settings === "object" ? plugin.settings : {},
          code: pluginSourceOf(plugin),
        })),
      };
      return {
        fileName: `${EXPORT_PREFIX}plugins-${dateStamp()}.json`,
        text: JSON.stringify(payload, null, 2),
      };
    }

    function textBytes(text) {
      try {
        if (typeof TextEncoder !== "undefined") return new TextEncoder().encode(String(text));
      } catch (err) { /* ignore */ }
      const encoded = unescape(encodeURIComponent(String(text)));
      const out = new Uint8Array(encoded.length);
      for (let i = 0; i < encoded.length; i += 1) out[i] = encoded.charCodeAt(i);
      return out;
    }

    function base64FromBytes(bytes) {
      let binary = "";
      const step = 0x8000;
      for (let i = 0; i < bytes.length; i += step) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + step));
      }
      return btoa(binary);
    }

    function crc32(bytes) {
      let table = crc32.table;
      if (!table) {
        table = [];
        for (let n = 0; n < 256; n += 1) {
          let c = n;
          for (let k = 0; k < 8; k += 1) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
          table[n] = c >>> 0;
        }
        crc32.table = table;
      }
      let crc = 0xffffffff;
      for (let i = 0; i < bytes.length; i += 1) crc = table[(crc ^ bytes[i]) & 0xff] ^ (crc >>> 8);
      return (crc ^ 0xffffffff) >>> 0;
    }

    function createZip(files) {
      const chunks = [];
      const entries = [];
      let offset = 0;
      const push = (bytes) => { chunks.push(bytes); offset += bytes.length; };
      const u16 = (value) => {
        const b = new Uint8Array(2);
        b[0] = value & 0xff;
        b[1] = (value >>> 8) & 0xff;
        return b;
      };
      const u32 = (value) => {
        const b = new Uint8Array(4);
        b[0] = value & 0xff;
        b[1] = (value >>> 8) & 0xff;
        b[2] = (value >>> 16) & 0xff;
        b[3] = (value >>> 24) & 0xff;
        return b;
      };
      const now = new Date();
      const dosTime = ((now.getHours() << 11) | (now.getMinutes() << 5) | (now.getSeconds() >> 1)) & 0xffff;
      const dosDate = (((now.getFullYear() - 1980) << 9) | ((now.getMonth() + 1) << 5) | now.getDate()) & 0xffff;

      for (let i = 0; i < files.length; i += 1) {
        const file = files[i];
        const name = textBytes(file.name);
        const data = file.bytes instanceof Uint8Array ? file.bytes : textBytes(file.text || "");
        const crc = crc32(data);
        const localOffset = offset;
        push(u32(0x04034b50));
        push(u16(20));
        push(u16(0x0800));
        push(u16(0));
        push(u16(dosTime));
        push(u16(dosDate));
        push(u32(crc));
        push(u32(data.length));
        push(u32(data.length));
        push(u16(name.length));
        push(u16(0));
        push(name);
        push(data);
        entries.push({ name, crc, size: data.length, offset: localOffset, time: dosTime, date: dosDate });
      }

      const centralStart = offset;
      for (let i = 0; i < entries.length; i += 1) {
        const entry = entries[i];
        push(u32(0x02014b50));
        push(u16(20));
        push(u16(20));
        push(u16(0x0800));
        push(u16(0));
        push(u16(entry.time));
        push(u16(entry.date));
        push(u32(entry.crc));
        push(u32(entry.size));
        push(u32(entry.size));
        push(u16(entry.name.length));
        push(u16(0));
        push(u16(0));
        push(u16(0));
        push(u16(0));
        push(u32(0));
        push(u32(entry.offset));
        push(entry.name);
      }
      const centralSize = offset - centralStart;

      push(u32(0x06054b50));
      push(u16(0));
      push(u16(0));
      push(u16(entries.length));
      push(u16(entries.length));
      push(u32(centralSize));
      push(u32(centralStart));
      push(u16(0));

      const total = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
      const out = new Uint8Array(total);
      let at = 0;
      for (let i = 0; i < chunks.length; i += 1) {
        out.set(chunks[i], at);
        at += chunks[i].length;
      }
      return out;
    }

    function downloadBytes(filename, bytes, mime) {
      const shell = shellSaver();
      if (shell) {
        const base64 = base64FromBytes(bytes);
        if (typeof shell.saveFileWithPicker === "function") {
          if (launchSavePicker(shell, filename, base64, mime)) return "picker";
        }
        try {
          if (shell.saveBase64File(filename, base64) === true) return "download";
        } catch (err) { /* ignore */ }
      }

      try {
        const BlobCtor = typeof Blob !== "undefined" ? Blob : (win.Blob || null);
        const URLObj = typeof URL !== "undefined" ? URL : (win.URL || null);
        if (!BlobCtor || !URLObj || typeof URLObj.createObjectURL !== "function") return false;
        const blob = new BlobCtor([bytes], { type: mime });
        const url = URLObj.createObjectURL(blob);
        const a = doc.createElement("a");
        a.href = url;
        a.download = filename;
        a.rel = "noopener";
        a.style.display = "none";
        doc.body.appendChild(a);
        a.click();
        later(() => {
          try {
            if (a.parentNode) a.parentNode.removeChild(a);
          } catch (err) { /* ignore */ }
          try { URLObj.revokeObjectURL(url); } catch (err) { /* ignore */ }
        }, 1500);
        return "browser";
      } catch (err) {
        return false;
      }
    }

    function exportAllPlugins() {
      const { fileName, text } = buildExportBundle(plugins);
      const result = downloadText(fileName, text, "application/json");
      const picker = result === "picker";
      const ok = Boolean(result);
      copyText(text)
        .then(() => notify(ok ? "success" : "error", ok
          ? (picker
            ? "已打开保存位置，选好后即可保存（已复制全部插件）"
            : (shellSaver() ? "已保存到「下载」并复制全部插件" : "已开始下载并复制全部插件"))
          : "无法下载，已复制全部插件 JSON"))
        .catch(() => notify(ok ? "success" : "error", ok
          ? (picker ? "已打开保存位置，选好后即可保存" : downloadSavedText(fileName))
          : "导出失败，请逐个插件复制源码"));
    }

    function exportAllAsJsFiles() {
      const files = [];
      for (let i = 0; i < plugins.length; i += 1) {
        const plugin = plugins[i];
        const code = pluginSourceOf(plugin);
        if (!code.trim()) continue;
        const base = `${plugin.manifest.id}-${plugin.manifest.version || "plugin"}`;
        files.push({ fileName: `${exportFileName(base)}.js`, code });
      }
      if (!files.length) {
        notify("error", "没有可导出的插件源码");
        return;
      }
      for (let i = 0; i < files.length; i += 1) {
        const file = files[i];
        const start = () => {
          try { downloadText(file.fileName, file.code, "text/javascript", { picker: false }); } catch (err) { /* ignore */ }
        };
        if (i === 0) start();
        else later(start, i * 260);
      }
      notify("success", `已开始导出 ${files.length} 个 .js 文件`);
    }

    function exportAllAsZip() {
      const files = [];
      for (let i = 0; i < plugins.length; i += 1) {
        const plugin = plugins[i];
        const code = pluginSourceOf(plugin);
        if (!code.trim()) continue;
        const base = `${plugin.manifest.id}-${plugin.manifest.version || "plugin"}`;
        files.push({ name: `${exportFileName(base)}.js`, text: code });
      }
      if (!files.length) {
        notify("error", "没有可导出的插件源码");
        return;
      }
      const readme = [
        "doremy chat plugins backup",
        `导出时间：${new Date().toISOString()}`,
        "",
        "包含插件：",
        ...files.map((file) => `- ${file.name}`),
        "",
        "安装：设置 → 扩展插件 → 安装插件，选择对应 .js；或 插件管理 → 导入。",
      ].join("\n");
      const zipFiles = [{ name: "README.txt", text: readme }].concat(files);
      const bytes = createZip(zipFiles);
      const fileName = `${EXPORT_PREFIX}plugins-${dateStamp()}.zip`;
      const result = downloadBytes(fileName, bytes, "application/zip");
      if (result === "picker") notify("success", "已打开保存位置，选好后即可保存");
      else if (result === "download") notify("success", `已保存到「下载」：${fileName}`);
      else if (result === "browser") notify("success", `已开始下载 ${fileName}`);
      else notify("error", "打包失败，请重试");
    }

    function openExportPicker() {
      if (pickerHandle) return;
      ensureBridge();
      if (!bridge) {
        notify("error", "当前版本取不到插件接口，请用「管理」里的导出");
        return;
      }
      plugins = loadPlugins();
      if (!plugins.length) {
        notify("error", "还没有安装插件");
        return;
      }

      const selected = new Set(plugins.map((item) => item.manifest.id));
      const handle = ctx.ui.openModal((root, api) => {
        let closed = false;
        const rerender = () => {
          if (closed) return;
          renderPicker(root, api, rerender, selected);
        };
        root.classList.add("pmt-modal", "pmt-picker");
        root.textContent = "";
        renderPicker(root, api, rerender, selected);
        return () => {
          closed = true;
          pickerHandle = null;
        };
      });
      pickerHandle = handle || null;
    }

    function renderPicker(root, api, rerender, selected) {
      while (root.firstChild) root.removeChild(root.firstChild);

      const head = element("div", "pmt-head");
      head.appendChild(element("div", "pmt-title", "导出插件"));
      const cancel = element("button", "pmt-done", "取消");
      cancel.type = "button";
      cancel.addEventListener("click", () => {
        if (api && typeof api.close === "function") api.close();
        else if (pickerHandle && typeof pickerHandle.close === "function") pickerHandle.close();
      });
      head.appendChild(cancel);
      root.appendChild(head);

      root.appendChild(element("p", "pmt-tip", "勾选要导出的插件（可单选、多选或全选），每个插件导出为 .js 文件。"));

      const allSelected = plugins.every((item) => selected.has(item.manifest.id));
      const tools = element("div", "pmt-picker-tools");
      const selectAll = element("button", "pmt-action pmt-picker-all", allSelected ? "取消全选" : "全选");
      selectAll.type = "button";
      selectAll.addEventListener("click", () => {
        if (plugins.every((item) => selected.has(item.manifest.id))) selected.clear();
        else plugins.forEach((item) => selected.add(item.manifest.id));
        rerender();
      });
      tools.appendChild(selectAll);
      tools.appendChild(element("span", "pmt-count", `已选 ${selected.size} / ${plugins.length}`));
      root.appendChild(tools);

      const list = element("div", "pmt-picker-list");
      for (let i = 0; i < plugins.length; i += 1) {
        const plugin = plugins[i];
        const on = selected.has(plugin.manifest.id);
        const row = element("button", "pmt-picker-row");
        row.type = "button";
        row.setAttribute("role", "checkbox");
        row.setAttribute("aria-checked", on ? "true" : "false");
        row.appendChild(element("span", "pmt-picker-box"));
        const name = `${plugin.manifest.name || plugin.manifest.id}${plugin.manifest.version ? ` v${plugin.manifest.version}` : ""}`;
        row.appendChild(element("span", "pmt-picker-name", name));
        row.addEventListener("click", () => {
          if (selected.has(plugin.manifest.id)) selected.delete(plugin.manifest.id);
          else selected.add(plugin.manifest.id);
          rerender();
        });
        list.appendChild(row);
      }
      root.appendChild(list);

      const foot = element("div", "pmt-actions");
      const exportBtn = element("button", "pmt-action pmt-picker-export", "导出所选（.js）");
      exportBtn.type = "button";
      exportBtn.disabled = selected.size === 0;
      exportBtn.addEventListener("click", () => {
        const chosen = plugins.filter((item) => selected.has(item.manifest.id));
        if (!chosen.length) {
          notify("error", "先勾选至少一个插件");
          return;
        }

        const files = [];
        for (let i = 0; i < chosen.length; i += 1) {
          const plugin = chosen[i];
          const code = pluginSourceOf(plugin);
          if (!String(code || "").trim()) continue;
          const base = `${plugin.manifest.id}-${plugin.manifest.version || "plugin"}`;
          files.push({ fileName: `${exportFileName(base)}.js`, code });
        }
        if (!files.length) {
          notify("error", "选中的插件没有保存源码，无法导出");
          return;
        }

        // 单个直接下载；多个按 260ms 错开，降低 Android WebView 连续下载被拦的概率
        const single = files.length === 1;
        const firstResult = downloadText(files[0].fileName, files[0].code, "text/javascript", { picker: single });
        if (single) {
          if (firstResult === "picker") {
            notify("success", "已打开保存位置，选好后即可保存");
            if (api && typeof api.close === "function") api.close();
          } else if (firstResult) {
            notify("success", downloadSavedText(files[0].fileName));
            if (api && typeof api.close === "function") api.close();
          } else {
            notify("error", "导出失败，请重试或到「管理」里逐个复制源码");
          }
          return;
        }

        for (let i = 1; i < files.length; i += 1) {
          const file = files[i];
          later(() => {
            try { downloadText(file.fileName, file.code, "text/javascript", { picker: false }); } catch (err) { /* ignore */ }
          }, i * 260);
        }
        const skipped = chosen.length - files.length;
        notify("success", `${shellSaver() ? "已保存到「下载」" : "已开始导出"} ${files.length} 个 .js 文件${skipped ? `（${skipped} 个无源码已跳过）` : ""}`);
        if (api && typeof api.close === "function") api.close();
      });
      foot.appendChild(exportBtn);
      root.appendChild(foot);
    }

    // ── 宿主「扩展插件」页：在「导入插件」下面补一个「导出插件」──────
    // 注意：这个按钮挂在 document.body 上，用 fixed 定位贴在导入按钮下方。
    // 不能插进宿主页面的 React 节点里——插件列表一变化，React 重排子节点会整页崩。
    let hostExportEl = null;
    let hostPaddedSection = null;
    let hostOriginalPadding = "";
    let hostGroupEl = null;
    let hostGroupObserver = null;
    let hostInstallInput = null;
    let hostInstallInputHandler = null;
    let hostHintGroup = null;
    let hostHintText = "";

    const normalizeText = (value) => String(value == null ? "" : value).replace(/\s+/g, " ").trim();


    function findInstallParts() {
      const titles = doc.querySelectorAll(".settings-menu-section-title");
      for (let i = 0; i < titles.length; i += 1) {
        if (normalizeText(titles[i].textContent) !== "安装插件") continue;
        const section = titles[i].parentNode;
        if (!section) continue;
        const kids = Array.from(section.children || []);
        const start = kids.indexOf(titles[i]);
        for (let j = start + 1; j < kids.length; j += 1) {
          const group = kids[j];
          if (!group.classList || !group.classList.contains("menu-group")) continue;
          const items = Array.from(group.querySelectorAll(".menu-item") || []);
          let importBtn = null;
          for (let k = 0; k < items.length; k += 1) {
            if (items[k].classList.contains(HOST_EXPORT_CLASS)) continue;
            if (normalizeText(items[k].textContent).indexOf("导入插件") >= 0) {
              importBtn = items[k];
              break;
            }
          }
          if (!importBtn && items.length) importBtn = items[0];
          if (!importBtn) return null;
          return { button: importBtn, group, section };
        }
      }
      return null;
    }

    function restoreHostPadding() {
      if (hostPaddedSection) {
        try { hostPaddedSection.style.paddingBottom = hostOriginalPadding; } catch (err) { /* ignore */ }
      }
      hostPaddedSection = null;
      hostOriginalPadding = "";
    }

    function watchHostGroup(group) {
      if (hostGroupEl === group && hostGroupObserver) return;
      if (hostGroupObserver) {
        try { hostGroupObserver.disconnect(); } catch (err) { /* ignore */ }
      }
      hostGroupEl = group;
      hostGroupObserver = null;
      if (typeof MutationObserver === "undefined") return;
      try {

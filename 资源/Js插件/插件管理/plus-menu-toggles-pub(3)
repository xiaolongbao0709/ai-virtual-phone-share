    async function doImportBundle(bundle, rerender) {
      const gen = modalGen;
      const items = bundle.plugins.filter((item) => item
        && typeof item.code === "string"
        && item.code.trim()
        && !(item.manifest && item.manifest.id === selfId));
      if (!items.length) {
        importResult = { ok: false, error: "备份里没有可导入的插件源码（只有本插件自己时，请到扩展插件页升级）。" };
        notify("error", importResult.error);
        rerender();
        return;
      }

      importBusy = true;
      importResult = null;
      rerender();

      let okCount = 0;
      const failures = [];
      for (let i = 0; i < items.length; i += 1) {
        const item = items[i];
        const name = (item.manifest && (item.manifest.name || item.manifest.id)) || "插件";
        try {
          const result = await bridge.install(item.code);
          if (result && result.ok) okCount += 1;
          else failures.push(`${name}：${(result && result.error) || "导入失败"}`);
        } catch (err) {
          failures.push(`${name}：${err && err.message ? err.message : String(err)}`);
        }
      }
      if (gen !== modalGen) return;

      importBusy = false;
      plugins = loadPlugins();
      if (failures.length) {
        importResult = { ok: false, bundle: true, count: okCount, failed: failures.length, error: failures[0] };
        notify(okCount ? "success" : "error", okCount
          ? `已导入 ${okCount} 个插件，${failures.length} 个失败`
          : `导入失败：${failures[0]}`);
      } else {
        importResult = { ok: true, bundle: true, count: okCount };
        notify("success", `已导入 ${okCount} 个插件`);
      }
      rerender();
    }

    async function doImport(code, rerender) {
      const source = String(code || "").replace(/^\uFEFF/, "").trim();
      const bundle = parsePluginBundle(source);
      if (bundle) {
        await doImportBundle(bundle, rerender);
        return;
      }

      const gen = modalGen;
      importBusy = true;
      importResult = null;
      rerender();

      let result;
      try {
        result = await bridge.install(source);
      } catch (err) {
        result = { ok: false, error: err && err.message ? err.message : String(err) };
      }

      if (gen !== modalGen) return;
      importBusy = false;
      importResult = result && typeof result === "object"
        ? result
        : { ok: false, error: "导入失败" };

      if (importResult.ok) {
        plugins = loadPlugins();
        notify("success", importSummary(importResult).text);
      } else {
        notify("error", importResult.error || "导入失败");
      }
      rerender();

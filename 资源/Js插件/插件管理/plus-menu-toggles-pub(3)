    // 升级本插件：先关掉管理浮层，再让宿主停/启；结果用宿主 toast 提示，避免拆浮层时整页崩
    function startSelfUpgrade(code, manifest) {
      const installed = plugins.find((item) => item.manifest.id === selfId);
      const from = installed && installed.manifest.version ? `v${installed.manifest.version}` : "旧版本";
      const to = manifest && manifest.version ? `v${manifest.version}` : "新版本";

      try {
        if (modalHandle && typeof modalHandle.close === "function") modalHandle.close();
      } catch (err) { /* ignore */ }

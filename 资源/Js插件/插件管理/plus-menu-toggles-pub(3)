      if (!text) return "";
      if (bundle) return `备份：${bundle.plugins.length} 个插件`;
      const manifest = manifestFromCode(text);
      if (!manifest) return "";
      const installed = plugins.find((item) => item.manifest.id === manifest.id);
      if (installed) {
        const from = installed.manifest.version ? `v${installed.manifest.version}` : "未知版本";
        const to = manifest.version ? `v${manifest.version}` : "未知版本";
        return `从 ${from} 升级为 ${to}`;
      }
      return manifest.version ? `新插件 v${manifest.version}` : "新插件";

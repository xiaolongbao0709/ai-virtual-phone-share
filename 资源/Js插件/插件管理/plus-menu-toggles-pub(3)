          notify("error", importResult.error);
          rerender();
          return;
        }
        const bundle = parsePluginBundle(code);
        const manifest = manifestFromCode(code);
        // 在自己的浮层里升级自己：先关浮层再装，避免宿主停旧实例时拆浮层导致整页崩
        if (!bundle && ((manifest && manifest.id === selfId) || code.indexOf(selfId) >= 0)) {

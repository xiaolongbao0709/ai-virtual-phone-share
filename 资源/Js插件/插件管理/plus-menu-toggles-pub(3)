      }
      const name = result.name || "插件";
      if (result.upgraded) {
        const from = result.fromVersion ? `v${result.fromVersion}` : "旧版本";
        const to = result.toVersion ? `v${result.toVersion}` : "新版本";
        return { toast: `${from} 已升级为 ${to}`, text: `「${name}」${from} 已升级为 ${to}` };
      }
      const text = result.toVersion
        ? `导入成功：「${name}」v${result.toVersion}`
        : `导入成功：「${name}」`;
      return { toast: "导入成功", text };
    }

    // 导出的 .json 备份可以直接拖回来导入
    function parsePluginBundle(text) {
      const raw = String(text || "").trim();
      if (!raw || raw.charAt(0) !== "{") return null;
      try {
        const data = JSON.parse(raw);
        if (data && data.format === "doremy-chat-plugins" && Array.isArray(data.plugins)) return data;
      } catch (err) { /* 不是 JSON，按源码处理 */ }
      return null;
    }

    // 从源码里粗略读 manifest.id / version，用来在导入前显示“从 x 升级为 y”
    function manifestFromCode(code) {

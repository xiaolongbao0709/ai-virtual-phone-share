          status.textContent = importSummary(importResult).text;
        } else if (importResult.bundle && importResult.count > 0) {
          status.setAttribute("data-error", "1");
          status.textContent = `已导入 ${importResult.count} 个，${importResult.failed} 个失败：${importResult.error}`;
        } else {
          status.setAttribute("data-error", "1");
          status.textContent = importResult.error || "导入失败";
        }
        body.appendChild(status);
      }
    }

    function pluginTitle(plugin) {
      const title = element("div", "pmt-plugin-title");
      title.appendChild(element("span", "pmt-name", plugin.manifest.name || plugin.manifest.id));
      if (plugin.manifest.version) title.appendChild(element("span", "pmt-ver", `v${plugin.manifest.version}`));

          : (shell ? "点「下载 .js」后保存到系统「下载」目录（/sdcard/Download）。" : "浏览器下载目录。");
        const info = element("div", "pmt-export-help");
        const rows = [
          ["导出位置", locationText],
          ["文件大小", `约 ${sizeKb} KB（单插件 .js 源码）。`],
          ["包含内容", "只包含插件源码；不包含设置和启用状态。同 id 导入覆盖升级会保留手机上原有设置。"],
          ["备用方式", "下载没反应时，用「复制源码」保存到文本文件。"],
        ];
        for (let i = 0; i < rows.length; i += 1) {
          const row = element("div", "pmt-export-help-row");
          row.appendChild(element("strong", null, `${rows[i][0]}：`));
          row.appendChild(element("span", null, rows[i][1]));

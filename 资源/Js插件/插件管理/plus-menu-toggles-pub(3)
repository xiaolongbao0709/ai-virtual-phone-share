    function filteredPlugins() {
      const query = searchQuery.trim().toLowerCase();
      if (!query) return plugins;
      return plugins.filter((plugin) => {
        const manifest = plugin && plugin.manifest ? plugin.manifest : {};
        const text = [manifest.name, manifest.id, manifest.author, manifest.description, manifest.version]
          .filter((value) => typeof value === "string" && value)
          .join(" ")
          .toLowerCase();
        return text.indexOf(query) >= 0;
      });
    }

    function renderExportAllChoice(body, rerender) {
      const back = element("button", "pmt-back", "‹ 插件列表");
      back.type = "button";
      back.addEventListener("click", () => {
        exportAllView = false;
        exportAllHelp = false;
        restoreNormalScroll = true;
        rerender();
      });
      body.appendChild(back);

      const head = element("div", "pmt-export-choice-head");
      head.appendChild(element("div", "pmt-export-choice-title", "导出全部插件"));
      const helpBtn = element("button", "pmt-export-help-btn", "?");
      helpBtn.type = "button";
      helpBtn.setAttribute("aria-label", "三种格式的区别");
      helpBtn.setAttribute("aria-expanded", exportAllHelp ? "true" : "false");
      helpBtn.addEventListener("click", () => {
        exportAllHelp = !exportAllHelp;
        rerender();
      });
      head.appendChild(helpBtn);
      body.appendChild(head);

      if (exportAllHelp) {
        const help = element("div", "pmt-export-help");
        const rows = [
          ["JSON", "一个文件，包含所有插件的源码、设置和启用状态；适合整机备份。不能直接装，要从「插件管理 → 导入」。注意：当前导入只重装源码，设置需要重新配。"],
          [".js", "每个插件一个独立文件；可以直接在「安装插件」里装；适合分享/发布单个插件；不包含设置和启用状态。"],
          ["ZIP", "一个压缩包，内含每个 .js 和一份说明；适合一次下载/备份；解压后逐个安装。"],
        ];
        const shell = shellSaver();
        const canPick = Boolean(shell && typeof shell.saveFileWithPicker === "function");
        const jsonKb = Math.max(1, Math.round(buildExportBundle(plugins).text.length / 1024));
        const jsKb = Math.max(1, Math.round(plugins.reduce(
          (total, plugin) => total + pluginSourceOf(plugin).length,
          0,
        ) / 1024));
        rows.push(["导出位置", canPick
          ? "点导出后会先弹出系统保存位置，选好后保存到那里。"
          : (shell ? "保存到系统「下载」目录（/sdcard/Download）。" : "浏览器下载目录。")]);
        rows.push(["文件大小", `JSON 约 ${jsonKb} KB；多个 .js 合计约 ${jsKb} KB；ZIP 与 .js 合计接近（不压缩）。`]);
        for (let i = 0; i < rows.length; i += 1) {
          const row = element("div", "pmt-export-help-row");
          row.appendChild(element("strong", null, `${rows[i][0]}：`));
          row.appendChild(element("span", null, rows[i][1]));
          help.appendChild(row);
        }
        body.appendChild(help);
      }

      const list = element("div", "pmt-export-choice-list");
      const options = [
        { key: "json", title: "JSON 备份", desc: "一个文件 · 含设置和启用状态 · 适合整机备份" },
        { key: "js", title: "多个 .js", desc: "每个插件一个文件 · 可直接安装 · 适合分享" },
        { key: "zip", title: "ZIP 压缩包", desc: "一个压缩包 · 内含全部 .js · 适合一次下载" },
      ];
      for (let i = 0; i < options.length; i += 1) {
        const option = options[i];
        const btn = element("button", "pmt-export-option");
        btn.type = "button";
        btn.setAttribute("data-format", option.key);
        btn.appendChild(element("strong", null, option.title));
        btn.appendChild(element("span", "pmt-export-option-desc", option.desc));
        btn.addEventListener("click", () => {
          exportAllView = false;
          exportAllHelp = false;
          restoreNormalScroll = true;
          if (option.key === "json") exportAllPlugins();
          else if (option.key === "js") exportAllAsJsFiles();
          else exportAllAsZip();
          rerender();
        });
        list.appendChild(btn);
      }
      body.appendChild(list);
      body.appendChild(element("p", "pmt-tip", "点标题旁的 ? 看三种格式的区别。"));
    }

    function bodyViewKind(body) {
      if (!body) return "";
      if (body.querySelector(".pmt-export-option")) return "choice";
      if (body.querySelector(".pmt-export-code")) return "export";
      if (body.querySelector(".pmt-field")) return "settings";
      if (body.querySelector(".pmt-list")) return "list";
      if (body.querySelector(".pmt-code")) return "import";
      if (body.querySelector(".pmt-back")) return "settings";
      return "other";
    }

    function renderNormal(body, rerender) {
      const shown = filteredPlugins();
      const enabledCount = shown.filter((item) => item.enabled !== false).length;
      if (searchQuery) {
        body.appendChild(element(
          "p",
          "pmt-count",
          `筛选出 ${shown.length} 个 · 共 ${plugins.length} 个（启用 ${enabledCount} 个）`,
        ));
      } else {
        body.appendChild(element("p", "pmt-count", `已启用 ${enabledCount} 个 · 共 ${plugins.length} 个`));
      }

      if (!shown.length) {
        body.appendChild(element(
          "div",
          "pmt-empty",
          searchQuery ? `没有匹配「${searchQuery}」的插件。` : "还没有安装扩展插件。",
        ));
        return;
      }

      const refreshNormalCount = () => {
        const enabledCount = shown.filter((item) => item.enabled !== false).length;
        const countEl = body.querySelector(".pmt-count");
        if (!countEl) return;
        countEl.textContent = searchQuery
          ? `筛选出 ${shown.length} 个 · 共 ${plugins.length} 个（启用 ${enabledCount} 个）`
          : `已启用 ${enabledCount} 个 · 共 ${plugins.length} 个`;
      };

      const list = element("div", "pmt-list");
      for (let i = 0; i < shown.length; i += 1) {
        const plugin = shown[i];
        const row = element("div", "pmt-plugin");
        row.setAttribute("data-off", plugin.enabled === false ? "1" : "0");

        const main = element("div", "pmt-plugin-main");
        main.appendChild(pluginTitle(plugin));
        if (plugin.manifest.description) main.appendChild(element("div", "pmt-desc", plugin.manifest.description));

        const isSelf = plugin.manifest.id === selfId;
        const toggle = makeSwitch(plugin.enabled !== false, () => {
          if (isSelf) {
            toast("当前插件请在「设置 → 扩展插件」里停用");
            return;
          }
          const next = plugin.enabled === false;
          try {
            bridge.setEnabled(plugin.manifest.id, next);
            plugin.enabled = next;
            toggle.setAttribute("aria-checked", next ? "true" : "false");
            row.setAttribute("data-off", next ? "0" : "1");
            refreshNormalCount();
          } catch (err) {
            toast("操作失败，请重试");
            resetBridge();
          }
        }, isSelf);

        row.appendChild(main);
        const exportBtn = element("button", "pmt-export", "导出");
        exportBtn.type = "button";
        exportBtn.addEventListener("click", (event) => {
          if (event && event.stopPropagation) event.stopPropagation();
          listScrollChain = captureListScroll(list);
          openExport(plugin, rerender);
        });
        row.appendChild(exportBtn);
        row.appendChild(toggle);
        list.appendChild(row);
      }
      body.appendChild(list);
      const exportAll = element("button", "pmt-action pmt-export-all", "导出全部插件…");
      exportAll.type = "button";
      exportAll.addEventListener("click", () => {
        activeTab = "normal";
        detailId = null;
        importView = false;
        exportId = null;
        exportAllView = true;
        exportAllHelp = false;
        listScrollChain = captureListScroll(list);
        rerender();
      });
      body.appendChild(exportAll);
      body.appendChild(element(
        "p",
        "pmt-tip",
        "「导出」保存单个插件源码；「导出全部」可选 JSON 备份、多个 .js 或 ZIP。",
      ));
      if (restoreNormalScroll) {
        restoreNormalScroll = false;
        restoreListScrollState(list);
      }
    }

    function managerScroller(el) {
      let node = el;
      let guard = 0;
      while (node && guard < 20) {
        if (node.classList && node.classList.contains("pmt-modal")) return node;
        const scrollHeight = Number(node.scrollHeight) || 0;
        const clientHeight = Number(node.clientHeight) || 0;
        if (scrollHeight > clientHeight + 4) {
          let overflow = "";
          try {
            const style = win.getComputedStyle ? win.getComputedStyle(node) : null;
            overflow = style ? style.overflowY : "";
          } catch (err) { overflow = ""; }
          if (!overflow || /(auto|scroll|overlay)/.test(overflow)) return node;
        }
        node = node.parentNode;
        guard += 1;
      }
      return null;
    }

    function captureListScroll(list) {
      if (!list) return null;
      const chain = [];
      let node = list;
      let guard = 0;
      while (node && guard < 30) {
        chain.push(Number(node.scrollTop) || 0);
        node = node.parentNode;
        guard += 1;
      }
      return { chain, winY: Number(win.scrollY) || 0 };
    }

    function restoreListScrollState(list) {
      const state = listScrollChain;
      listScrollChain = null;
      if (!state || !list) return;
      const apply = () => {
        let node = list;
        let index = 0;
        while (node && index < state.chain.length) {
          const top = state.chain[index] || 0;
          if (top > 0) {
            try { node.scrollTop = top; } catch (err) { /* ignore */ }
          }
          node = node.parentNode;
          index += 1;
        }
        if (state.winY > 0) {
          try { win.scrollTo(0, state.winY); } catch (err) { /* ignore */ }
        }
      };
      apply();
      later(apply, 0);
      later(apply, 80);
      later(apply, 200);
    }

    function renderDetailList(body, rerender) {
      const shown = filteredPlugins();
      if (!shown.length) {
        body.appendChild(element(
          "div",
          "pmt-empty",
          searchQuery ? `没有匹配「${searchQuery}」的插件。` : "还没有安装扩展插件。",
        ));
        return;
      }
      body.appendChild(element("p", "pmt-tip", "点一个插件，进去改它的各项设置。"));

      const list = element("div", "pmt-list");
      for (let i = 0; i < shown.length; i += 1) {
        const plugin = shown[i];
        const fields = Array.isArray(plugin.manifest.settings) ? plugin.manifest.settings.length : 0;
        const row = element("div", "pmt-plugin pmt-clickable");
        row.setAttribute("role", "button");
        row.setAttribute("tabindex", "0");
        row.setAttribute("data-off", plugin.enabled === false ? "1" : "0");

        const main = element("div", "pmt-plugin-main");
        main.appendChild(pluginTitle(plugin));
        const sub = [];
        sub.push(fields ? `${fields} 项设置` : "没有可配置项");
        if (plugin.manifest.author) sub.push(plugin.manifest.author);
        main.appendChild(element("div", "pmt-desc", sub.join(" · ")));

        row.appendChild(main);
        row.appendChild(element("span", "pmt-chevron", "›"));

        const open = () => {
          listScrollChain = captureListScroll(list);
          restoreDetailScroll = true;
          detailId = plugin.manifest.id;
          rerender();
        };
        row.addEventListener("click", open);
        row.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            open();
          }
        });
        list.appendChild(row);
      }
      body.appendChild(list);
      if (restoreDetailScroll) {
        restoreDetailScroll = false;
        restoreListScrollState(list);
      }
    }

    function renderSettings(body, plugin, rerender) {
      const back = element("button", "pmt-back", "‹ 插件列表");
      back.type = "button";
      back.addEventListener("click", () => {
        detailId = null;
        restoreDetailScroll = true;
        rerender();
      });
      body.appendChild(back);

      const isSelf = plugin.manifest.id === selfId;
      const headRow = element("div", "pmt-plugin");
      const main = element("div", "pmt-plugin-main");
      main.appendChild(pluginTitle(plugin));
      if (plugin.manifest.description) main.appendChild(element("div", "pmt-desc", plugin.manifest.description));
      headRow.appendChild(main);
      const exportBtn = element("button", "pmt-export", "导出");
      exportBtn.type = "button";
      exportBtn.addEventListener("click", () => openExport(plugin, rerender));
      headRow.appendChild(exportBtn);
      const enableSwitch = makeSwitch(plugin.enabled !== false, () => {
        if (isSelf) {
          toast("当前插件请在「设置 → 扩展插件」里停用");
          return;
        }
        const next = plugin.enabled === false;
        try {
          bridge.setEnabled(plugin.manifest.id, next);
          plugin.enabled = next;
          enableSwitch.setAttribute("aria-checked", next ? "true" : "false");
          headRow.setAttribute("data-off", next ? "0" : "1");
        } catch (err) {
          toast("操作失败，请重试");
          resetBridge();
        }
      }, isSelf);
      headRow.appendChild(enableSwitch);
      body.appendChild(headRow);

      const fields = Array.isArray(plugin.manifest.settings) ? plugin.manifest.settings : [];
      if (!fields.length) {
        body.appendChild(element("div", "pmt-empty", "这个插件没有声明可配置项。"));
        return;
      }

      const list = element("div", "pmt-fields");
      for (let i = 0; i < fields.length; i += 1) {
        list.appendChild(renderField(plugin, fields[i]));
      }
      body.appendChild(list);
      body.appendChild(element("p", "pmt-tip", "改动即时保存，不需要额外确认。"));

      const resetBtn = element("button", "pmt-action pmt-reset-settings", "恢复默认");
      resetBtn.type = "button";
      resetBtn.addEventListener("click", () => {
        const defaults = {};
        for (const field of fields) {
          if (field && field.key) defaults[field.key] = field.default;
        }
        try {
          bridge.updateSettings(plugin.manifest.id, defaults);
          plugin.settings = { ...(plugin.settings || {}), ...defaults };
          toast("已恢复默认设置");
          rerender();
        } catch (err) {
          toast("恢复失败，请重试");
          resetBridge();
        }
      });
      body.appendChild(resetBtn);
    }

    function currentValue(plugin, field) {
      const key = field.key;
      const bag = plugin.settings && typeof plugin.settings === "object" ? plugin.settings : {};
      if (bag[key] !== undefined && bag[key] !== null) return bag[key];
      return field.default;
    }

    function saveField(plugin, field, value, statusEl) {
      try {
        bridge.updateSettings(plugin.manifest.id, { [field.key]: value });
        plugin.settings = { ...(plugin.settings || {}), [field.key]: value };
        markSaved(statusEl);
      } catch (err) {
        toast("保存失败，请重试");
        resetBridge();
      }
    }

    function fieldShell(field) {
      const box = element("div", "pmt-field");
      const head = element("div", "pmt-field-head");
      const label = element("span", "pmt-field-label", field.label || field.key);
      const status = element("span", "pmt-saved", "已保存");
      head.appendChild(label);
      head.appendChild(status);
      box.appendChild(head);
      return { box, head, status };
    }

    function renderField(plugin, field) {
      const value = currentValue(plugin, field);

      if (field.type === "boolean") {
        const shell = fieldShell(field);
        const toggle = makeSwitch(value === true, () => {
          const next = !(value === true);
          saveField(plugin, field, next, shell.status);
          toggle.setAttribute("aria-checked", next ? "true" : "false");
        }, false);
        shell.head.appendChild(toggle);
        if (field.description) shell.box.appendChild(element("p", "pmt-field-hint", field.description));
        return shell.box;
      }

      if (field.type === "select") {
        const shell = fieldShell(field);
        const select = element("select", "pmt-input pmt-select");
        const options = Array.isArray(field.options) ? field.options : [];
        for (let i = 0; i < options.length; i += 1) {
          const option = doc.createElement("option");
          option.value = String(options[i].value);
          option.textContent = options[i].label != null ? String(options[i].label) : String(options[i].value);
          select.appendChild(option);
        }
        select.value = value == null ? "" : String(value);
        select.addEventListener("change", () => {
          saveField(plugin, field, select.value, shell.status);
        });
        shell.box.appendChild(select);
        if (field.description) shell.box.appendChild(element("p", "pmt-field-hint", field.description));
        return shell.box;
      }

      if (field.type === "number") {
        const shell = fieldShell(field);
        const input = element("input", "pmt-input");
        input.type = "number";
        input.inputMode = "decimal";
        input.value = value == null ? "" : String(value);
        input.addEventListener("change", () => {
          const raw = String(input.value).trim();
          if (!raw) {
            input.value = value == null ? "" : String(value);
            return;
          }
          const num = Number(raw);
          if (!Number.isFinite(num)) {
            input.value = value == null ? "" : String(value);
            return;
          }
          saveField(plugin, field, num, shell.status);
        });
        shell.box.appendChild(input);
        if (field.description) shell.box.appendChild(element("p", "pmt-field-hint", field.description));
        return shell.box;
      }

      const shell = fieldShell(field);
      const input = element("input", "pmt-input");
      input.type = "text";
      input.value = value == null ? "" : String(value);
      input.addEventListener("change", () => {
        saveField(plugin, field, String(input.value), shell.status);
      });
      shell.box.appendChild(input);
      if (field.description) shell.box.appendChild(element("p", "pmt-field-hint", field.description));
      return shell.box;
    }

    // ── 清理 ──────────────────────────────────────────────
    return () => {
      try { if (typeof offSlot === "function") offSlot(); } catch (err) { /* ignore */ }
      if (typeof hostPollTimer === "function") {
        try { hostPollTimer(); } catch (err) { /* ignore */ }
      } else if (hostPollTimer != null && typeof win.clearInterval === "function") {
        try { win.clearInterval(hostPollTimer); } catch (err) { /* ignore */ }
      }
      hostPollTimer = null;
      if (hostGroupObserver) {
        try { hostGroupObserver.disconnect(); } catch (err) { /* ignore */ }
      }
      hostGroupObserver = null;
      hostGroupEl = null;
      if (hostInstallInput && hostInstallInputHandler) {
        try { hostInstallInput.removeEventListener("change", hostInstallInputHandler, true); } catch (err) { /* ignore */ }
      }
      hostInstallInput = null;
      hostInstallInputHandler = null;
      hostHintGroup = null;
      hostHintText = "";
      restoreHostPadding();
      disposeNativeTools();
      if (hostExportEl && hostExportEl.parentNode) {
        try { hostExportEl.parentNode.removeChild(hostExportEl); } catch (err) { /* ignore */ }
      }
      hostExportEl = null;
      try {
        if (typeof win.removeEventListener === "function") {
          win.removeEventListener("scroll", onHostScroll, true);
          win.removeEventListener("resize", onHostScroll);
        }
      } catch (err) { /* ignore */ }

      // 宿主停插件时可能正处在 React 渲染/提交阶段，直接关浮层会触发
      // “Cannot update a component while rendering” 之类的整页异常，延迟到下一轮再关。
      const picker = pickerHandle;
      pickerHandle = null;
      if (picker && typeof picker.close === "function") {
        later(() => { try { picker.close(); } catch (err) { /* ignore */ } }, 0);
      }

      toastTimers.forEach((timer) => { try { win.clearTimeout(timer); } catch (err) { /* ignore */ } });
      toastTimers.clear();
      if (toastWrap && toastWrap.parentNode) {
        try { toastWrap.parentNode.removeChild(toastWrap); } catch (err) { /* ignore */ }
      }
      toastWrap = null;

      const modal = modalHandle;
      modalHandle = null;
      modalGen += 1;
      if (modal && typeof modal.close === "function") {
        later(() => { try { modal.close(); } catch (err) { /* ignore */ } }, 0);
      }

      savedTimers.forEach((timer) => { try { win.clearTimeout(timer); } catch (err) { /* ignore */ } });
      savedTimers = [];
    };
  },
};

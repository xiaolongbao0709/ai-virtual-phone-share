              const a = result.fromVersion ? `v${result.fromVersion}` : from;
              const b = result.toVersion ? `v${result.toVersion}` : to;
              if (ctx.ui && typeof ctx.ui.toast === "function") ctx.ui.toast(`「${name}」${a} 已升级为 ${b}`);
            } else {
              if (ctx.ui && typeof ctx.ui.toast === "function") ctx.ui.toast(`导入失败：${(result && result.error) || "未知错误"}`);

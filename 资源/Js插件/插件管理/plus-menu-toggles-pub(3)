      return typeof req === "function" && req.m ? req : null;
    }

    // 生产包导出名会被混淆（如 {AA:()=>v,...}），按源码特征认三个函数
    function parseStorageModule(source) {
      const mapMatch = source.match(/\.d\(\s*[A-Za-z0-9_$]+\s*,\s*\{([^}]*)\}/);
      if (!mapMatch) return null;

      const keyByLocal = {};
      const mapRe = /([A-Za-z0-9_$]+)\s*:\s*\(\)\s*=>\s*([A-Za-z0-9_$]+)/g;
      let match;
      while ((match = mapRe.exec(mapMatch[1]))) keyByLocal[match[2]] = match[1];

      const declRe = /function\s+([A-Za-z0-9_$]+)\s*\(([^)]*)\)\s*\{/g;
      let loadName = null;
      let setEnabledName = null;
      let updateName = null;

      while ((match = declRe.exec(source))) {
        const name = match[1];
        const params = match[2].trim();
        const windowText = source.slice(match.index, match.index + 480);
        const argc = params ? params.split(",").length : 0;

        if (argc === 0
          && windowText.indexOf("Array.isArray") >= 0
          && windowText.indexOf(".manifest") >= 0
          && windowText.indexOf(".code") >= 0) {
          loadName = name;
        }
        if (argc === 2
          && windowText.indexOf(".enabled") >= 0
          && windowText.indexOf(".manifest.id") >= 0
          && windowText.indexOf("enabled=") >= 0) {
          setEnabledName = name;
        }
        if (argc === 2
          && windowText.indexOf(".settings") >= 0
          && (windowText.indexOf(".settings={...") >= 0
            || windowText.indexOf("...r.settings") >= 0
            || windowText.indexOf(".settings=Object.assign") >= 0)) {
          updateName = name;
        }
      }

      if (!loadName || !setEnabledName || !updateName) return null;
      if (loadName === setEnabledName || loadName === updateName || setEnabledName === updateName) return null;

      const loadKey = keyByLocal[loadName];
      const setKey = keyByLocal[setEnabledName];
      const updateKey = keyByLocal[updateName];
      if (!loadKey || !setKey || !updateKey) return null;
      return { loadKey, setKey, updateKey };
    }

    // 安装模块：源码里有「插件源码为空」「expectedId」「upgraded」的那个双参函数
    function parseLoaderModule(source) {
      const mapMatch = source.match(/\.d\(\s*[A-Za-z0-9_$]+\s*,\s*\{([^}]*)\}/);
      if (!mapMatch) return null;

      const keyByLocal = {};
      const mapRe = /([A-Za-z0-9_$]+)\s*:\s*\(\)\s*=>\s*([A-Za-z0-9_$]+)/g;
      let match;
      while ((match = mapRe.exec(mapMatch[1]))) keyByLocal[match[2]] = match[1];

      const declRe = /function\s+([A-Za-z0-9_$]+)\s*\(([^)]*)\)\s*\{/g;
      let installName = null;
      while ((match = declRe.exec(source))) {
        const params = match[2].trim();
        if (!params || params.split(",").length !== 2) continue;
        const windowText = source.slice(match.index, match.index + 620);
        if (windowText.indexOf("插件源码为空") >= 0
          && windowText.indexOf("expectedId") >= 0
          && windowText.indexOf("upgraded") >= 0) {
          installName = match[1];
        }
      }

      if (!installName) return null;
      const installKey = keyByLocal[installName];
      if (!installKey) return null;
      return { installKey };
    }

    function ensureBridge() {
      if (bridgeTried) return bridge;
      bridgeTried = true;
      bridgeError = "";
      bridge = null;

      const req = getWebpackRequire();
      if (!req) {
        bridgeError = "当前 App 的打包方式拿不到插件管理接口（可能不是 webpack 构建）。";
        return null;
      }

      let storage = null;
      let install = null;
      const ids = Object.keys(req.m);

      for (let i = 0; i < ids.length; i += 1) {
        if (storage && install) break;
        const id = ids[i];
        let source;
        try {
          source = String(req.m[id]);
        } catch (err) {
          continue;
        }

        if (!storage
          && source.indexOf("chat_plugins_v3") >= 0
          && source.indexOf("chat-plugins-changed") >= 0) {
          const parsed = parseStorageModule(source);
          if (parsed) {
            let exports = null;
            try { exports = req(id); } catch (err) { exports = null; }
            if (exports) {
              const load = exports[parsed.loadKey];
              const setEnabled = exports[parsed.setKey];
              const updateSettings = exports[parsed.updateKey];
              if (typeof load === "function" && typeof setEnabled === "function" && typeof updateSettings === "function") {
                try {
                  const list = load();
                  if (Array.isArray(list)) {
                    const eventMatch = source.match(/["']([^"']*plugins-changed[^"']*)["']/);
                    storage = { load, setEnabled, updateSettings, eventName: eventMatch ? eventMatch[1] : "chat-plugins-changed" };
                  }
                } catch (err) { /* ignore */ }
              }
            }
          }
        }

        if (!install
          && source.indexOf("插件源码为空") >= 0
          && source.indexOf("expectedId") >= 0) {
          const parsed = parseLoaderModule(source);
          if (parsed) {
            let exports = null;
            try { exports = req(id); } catch (err) { exports = null; }
            const fn = exports ? exports[parsed.installKey] : null;
            if (typeof fn === "function") install = fn;
          }
        }
      }

      if (!storage) {
        bridgeError = "找到了宿主代码，但没能读出插件列表。";
        return null;
      }

      bridge = { load: storage.load, setEnabled: storage.setEnabled, updateSettings: storage.updateSettings, install, eventName: storage.eventName || "chat-plugins-changed" };
      return bridge;
    }

    function resetBridge() {
      bridgeTried = false;
      bridge = null;
      bridgeError = "";
    }

    function loadPlugins() {
      if (!bridge) return [];
      try {
        const list = bridge.load();
        if (!Array.isArray(list)) return [];
        return list.filter((item) => item && item.manifest && typeof item.manifest.id === "string");
      } catch (err) {
        bridgeError = "读取插件列表失败。";
        return [];
      }
    }

    // ── 状态 ──────────────────────────────────────────────
    let modalHandle = null;
    let modalGen = 0;
    let activeTab = "normal";
    let detailId = null;
    let loading = false;
    let plugins = [];
    let savedTimers = [];
    let importView = false;
    let exportAllView = false;
    let exportAllHelp = false;
    let exportInfoOpen = false;
    let importCode = "";
    let importBusy = false;
    let importResult = null;
    let exportId = null;
    let searchQuery = "";
    let searchDraft = "";
    let detailScroll = 0;
    let detailScrollEl = null;
    let restoreDetailScroll = false;
    let listScrollChain = null;
    let restoreNormalScroll = false;
    let pickerHandle = null;
    let toastWrap = null;
    const toastTimers = new Set();

    function toast(text) {
      try {
        if (ctx.ui && typeof ctx.ui.toast === "function") ctx.ui.toast(text);
      } catch (err) { /* ignore */ }
    }

    // 自绘提示：成功白底绿字、失败深灰底白字（宿主 toast 改不了样式）
    function notify(kind, text) {
      try {
        if (!text) return;
        if (!toastWrap || !toastWrap.parentNode) {
          toastWrap = doc.createElement("div");
          toastWrap.className = "pmt-toast-wrap";
          (doc.body || doc.documentElement).appendChild(toastWrap);
        }
        const item = doc.createElement("div");
        item.className = "pmt-toast";
        item.setAttribute("data-kind", kind === "success" ? "success" : "error");
        item.textContent = String(text);
        toastWrap.appendChild(item);

        const timer = later(() => {
          toastTimers.delete(timer);
          if (item.parentNode) item.parentNode.removeChild(item);
          if (toastWrap && toastWrap.children.length === 0 && toastWrap.parentNode) {
            toastWrap.parentNode.removeChild(toastWrap);
            toastWrap = null;
          }
        }, kind === "success" ? 2600 : 3400);
        toastTimers.add(timer);
      } catch (err) { /* 提示失败不能影响主流程 */ }
    }

    function markSaved(span) {
      if (!span) return;
      span.setAttribute("data-on", "1");
      const timer = later(() => {
        span.removeAttribute("data-on");
        savedTimers = savedTimers.filter((item) => item !== timer);
      }, 1200);
      savedTimers.push(timer);
    }

    // ── 入口按钮 ──────────────────────────────────────────
    let offSlot = () => {};
    try {
      const dispose = ctx.ui.slot("chat.inputToolbar", (el) => {
        try {
          const row = doc.createElement("div");
          row.className = "pmt-row";

          const item = doc.createElement("div");
          item.className = "chat-plus-menu-item pmt-entry";
          item.setAttribute("role", "button");
          item.setAttribute("tabindex", "0");
          item.setAttribute("title", "管理扩展插件");
          item.setAttribute("data-panel-manager", "1");
          const box = doc.createElement("div");
          box.className = "chat-plus-icon-box";
          box.innerHTML = SLIDERS_SVG;

          const label = doc.createElement("span");
          label.className = "ts-11";
          label.textContent = ENTRY_LABEL;

          item.appendChild(box);
          item.appendChild(label);

          const activate = () => openManager();
          item.addEventListener("click", activate);
          item.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              activate();
            }
          });

          row.appendChild(item);
          el.insertBefore(row, el.firstChild || null);

          return () => {
            try {
              if (row.parentNode) row.parentNode.removeChild(row);
            } catch (err) { /* ignore */ }
          };
        } catch (err) {
          return () => {};
        }
      });
      if (typeof dispose === "function") offSlot = dispose;
      else if (dispose && typeof dispose.dispose === "function") offSlot = () => dispose.dispose();
    } catch (err) { /* 槽位注册失败也不把宿主带崩 */ }

    // ── 浮层 ──────────────────────────────────────────────
    function openManager() {
      if (modalHandle) return;
      activeTab = "normal";
      detailId = null;
      detailScroll = 0;
      detailScrollEl = null;
      restoreDetailScroll = false;
      listScrollChain = null;
      restoreNormalScroll = false;
      loading = true;
      plugins = [];
      importView = false;
      exportAllView = false;
      exportAllHelp = false;
      exportInfoOpen = false;
      importCode = "";
      importBusy = false;
      importResult = null;
      exportId = null;
      searchQuery = "";
      searchDraft = "";

      const handle = ctx.ui.openModal((root, api) => {
        let closed = false;
        const gen = ++modalGen;
        root.classList.add("pmt-modal");
        root.textContent = "";

        const rerender = () => {
          if (closed) return;
          const oldBody = root.querySelector(".pmt-body");
          const oldKind = bodyViewKind(oldBody);
          const oldChain = oldBody ? captureListScroll(oldBody) : null;
          renderModal(root, api, rerender);
          const newBody = root.querySelector(".pmt-body");
          if (oldKind && oldChain && newBody && bodyViewKind(newBody) === oldKind) {
            // 开关、设置值等“同类视图”刷新时保持当前位置；跳转由各返回路径单独处理
            listScrollChain = oldChain;
            restoreListScrollState(newBody);
          }
        };
        renderModal(root, api, rerender);

        // 模块表扫描可能要几十到几百毫秒，先让界面画出来再扫
        later(() => {
          if (closed || gen !== modalGen) return;
          ensureBridge();
          plugins = loadPlugins();
          loading = false;
          rerender();
        }, 30);

        return () => {
          closed = true;
          modalHandle = null;
          savedTimers.forEach((timer) => { try { win.clearTimeout(timer); } catch (err) { /* ignore */ } });
          savedTimers = [];
        };
      });
      modalHandle = handle || null;
    }

    function element(tag, className, text) {
      const el = doc.createElement(tag);
      if (className) el.className = className;
      if (text != null) el.textContent = text;
      return el;
    }

    function makeSwitch(checked, onChange, disabled) {
      const button = element("button", "pmt-switch");
      button.type = "button";
      button.setAttribute("role", "switch");
      button.setAttribute("aria-checked", checked ? "true" : "false");
      if (disabled) button.disabled = true;
      button.addEventListener("click", (event) => {
        if (event && event.stopPropagation) event.stopPropagation();
        onChange();
      });
      return button;
    }

    function renderModal(root, api, rerender) {
      while (root.firstChild) root.removeChild(root.firstChild);

      const head = element("div", "pmt-head");
      head.appendChild(element("div", "pmt-title", "插件管理"));

      const importBtn = element("button", "pmt-done pmt-import-open", "导入");
      importBtn.type = "button";
      importBtn.addEventListener("click", () => {
        activeTab = "normal";
        detailId = null;
        exportAllView = false;
        exportAllHelp = false;
        const listForImport = root.querySelector(".pmt-list");
        if (listForImport) listScrollChain = captureListScroll(listForImport);
        importView = true;
        importResult = null;
        exportId = null;
        rerender();
      });
      head.appendChild(importBtn);

      const done = element("button", "pmt-done", "完成");
      done.type = "button";
      done.addEventListener("click", () => {
        // 在某个插件的详细设置页里，完成 = 回到详细列表（恢复原滚动位置），不退出管理
        if (detailId) {
          detailId = null;
          restoreDetailScroll = true;
          rerender();
          return;
        }
        if (api && typeof api.close === "function") api.close();
        else if (modalHandle && typeof modalHandle.close === "function") modalHandle.close();
        modalHandle = null;
      });
      head.appendChild(done);

      const tabs = element("div", "pmt-tabs");
      const tabDefs = [["normal", "普通调整"], ["detail", "详细调整"]];
      for (let i = 0; i < tabDefs.length; i += 1) {
        const key = tabDefs[i][0];
        const tab = element("button", "pmt-tab", tabDefs[i][1]);
        tab.type = "button";
        tab.setAttribute("data-tab", key);
        tab.setAttribute("data-active", key === activeTab && !importView ? "1" : "0");
        tab.addEventListener("click", () => {
          activeTab = key;
          detailId = null;
          importView = false;
          exportAllView = false;
          exportAllHelp = false;
          restoreNormalScroll = false;
          restoreDetailScroll = false;
          listScrollChain = null;
          exportId = null;
          rerender();
        });
        tabs.appendChild(tab);
      }

      const body = element("div", "pmt-body");
      if (loading) {
        body.appendChild(element("div", "pmt-empty", "正在读取插件列表…"));
      } else if (!bridge) {
        renderBridgeError(body, rerender);
      } else if (exportAllView) {
        renderExportAllChoice(body, rerender);
      } else if (importView) {
        renderImport(body, rerender);
      } else if (exportId) {
        const plugin = plugins.find((item) => item.manifest.id === exportId);
        if (plugin) renderExport(body, plugin, rerender);
        else { exportId = null; renderNormal(body, rerender); }
      } else if (activeTab === "detail" && detailId) {
        const plugin = plugins.find((item) => item.manifest.id === detailId);
        if (plugin) renderSettings(body, plugin, rerender);
        else { detailId = null; renderDetailList(body, rerender); }
      } else if (activeTab === "detail") {
        renderDetailList(body, rerender);
      } else {
        renderNormal(body, rerender);
      }

      root.appendChild(head);

      if (!importView && !exportId) {
        const search = element("div", "pmt-search");
        const input = doc.createElement("input");
        input.type = "search";
        input.className = "pmt-search-input";
        input.setAttribute("placeholder", "搜索插件：名称 / id / 作者 / 描述");
        input.value = searchDraft;
        input.addEventListener("input", () => { searchDraft = input.value; });
        const runSearch = () => {
          searchQuery = String(input.value || "").trim();
          searchDraft = searchQuery;
          detailId = null;
          restoreDetailScroll = false;
          rerender();
        };
        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            runSearch();
          }
        });
        const searchBtn = element("button", "pmt-search-btn", "搜索");
        searchBtn.type = "button";
        searchBtn.addEventListener("click", runSearch);
        search.appendChild(input);
        search.appendChild(searchBtn);
        if (searchQuery) {
          const clear = element("button", "pmt-search-clear", "×");
          clear.type = "button";
          clear.setAttribute("aria-label", "清除搜索");
          clear.addEventListener("click", () => {
            searchQuery = "";
            searchDraft = "";
            detailId = null;
            rerender();
          });
          search.appendChild(clear);
        }
        root.appendChild(search);
        if (searchQuery) {
          root.appendChild(element("p", "pmt-search-tip", `筛选「${searchQuery}」`));
        }
      }

      root.appendChild(tabs);
      root.appendChild(body);
    }

    function renderBridgeError(body, rerender) {
      const box = element("div", "pmt-error");
      box.appendChild(element("p", null, bridgeError || "读不到插件管理接口。"));
      box.appendChild(element(
        "p",
        null,
        "这个 App 版本的打包方式可能变了。你仍然可以在「设置 → 扩展插件」里启停插件、改各项设置。",
      ));
      const retry = element("button", "pmt-retry", "重试");
      retry.type = "button";
      retry.addEventListener("click", () => {
        resetBridge();
        loading = true;
        rerender();
        later(() => {
          ensureBridge();
          plugins = loadPlugins();
          loading = false;
          rerender();
        }, 30);
      });
      box.appendChild(retry);
      body.appendChild(box);
    }

    function readFileText(file) {
      if (file && typeof file.text === "function") return file.text();
      return new Promise((resolve, reject) => {
        try {
          if (typeof FileReader === "undefined") {
            reject(new Error("no FileReader"));
            return;
          }
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result || ""));
          reader.onerror = () => reject(reader.error || new Error("read failed"));
          reader.readAsText(file);
        } catch (err) {
          reject(err);
        }
      });
    }

    // ── 导出插件 ──────────────────────────────────────────
    function pluginSourceOf(plugin) {
      return plugin && typeof plugin.code === "string" ? plugin.code : "";
    }

    function safeFileName(name) {
      const cleaned = String(name || "")
        .replace(/[\\/:*?"<>|\s]+/g, "-")
        .replace(/^-+|-+$/g, "");
      return cleaned || "plugin";
    }

    // 壳的保存桥只能写 Download 根目录，文件名统一加前缀，至少能聚在一起找
    const EXPORT_PREFIX = "导出插件-";
    function exportFileName(base) {
      return `${EXPORT_PREFIX}${safeFileName(base)}`;
    }

    function dateStamp() {
      const d = new Date();
      const two = (value) => String(value).padStart(2, "0");
      return `${d.getFullYear()}${two(d.getMonth() + 1)}${two(d.getDate())}-${two(d.getHours())}${two(d.getMinutes())}`;
    }

    function shellSaver() {
      try {
        const shell = (typeof window !== "undefined" ? window : win).AndroidShell;
        if (shell && typeof shell.saveBase64File === "function") return shell;
      } catch (err) { /* ignore */ }
      return null;
    }

    function base64FromText(text) {
      try {
        if (typeof TextEncoder !== "undefined" && typeof btoa === "function") {
          const bytes = new TextEncoder().encode(String(text));
          let binary = "";
          const step = 0x8000;
          for (let i = 0; i < bytes.length; i += step) {
            binary += String.fromCharCode.apply(null, bytes.subarray(i, i + step));
          }
          return btoa(binary);
        }
      } catch (err) { /* ignore */ }
      return "";
    }

    // 宿主壳里 blob + a[download] 不会落盘（DownloadManager 取不到内存地址），
    // 必须把 base64 交给 AndroidShell，从 MediaStore 写进公共「下载」目录。
    const saveCallbacks = {};
    function ensureSaveCallbackBridge() {
      try {
        if (typeof win.__pmtOnSaveFile === "function") return;
        win.__pmtOnSaveFile = (id, ok) => {
          const key = String(id || "");
          const callback = saveCallbacks[key];
          if (!callback) return;
          delete saveCallbacks[key];
          try { callback(Boolean(ok)); } catch (err) { /* ignore */ }
        };
      } catch (err) { /* ignore */ }
    }

    function launchSavePicker(shell, filename, base64, mime) {
      try {
        ensureSaveCallbackBridge();
        const id = `pmt_save_${Date.now()}_${Math.floor(Math.random() * 1000000)}`;
        saveCallbacks[id] = (ok) => {
          notify(ok ? "success" : "error", ok ? "已保存到所选位置" : "已取消保存");
        };
        let launched;
        try {
          launched = shell.saveFileWithPicker(filename, base64, id, mime || "application/octet-stream");
        } catch (err) {
          delete saveCallbacks[id];
          return false;
        }
        if (launched !== false) {
          later(() => { delete saveCallbacks[id]; }, 10 * 60 * 1000);
          return true;
        }
        delete saveCallbacks[id];
      } catch (err) { /* ignore */ }
      return false;
    }

    function downloadText(filename, text, mime, options) {
      const allowPicker = !options || options.picker !== false;
      const shell = shellSaver();
      if (shell) {
        const base64 = base64FromText(text);
        if (base64) {
          if (allowPicker && typeof shell.saveFileWithPicker === "function") {
            if (launchSavePicker(shell, filename, base64, mime)) return "picker";
          }
          try {
            if (shell.saveBase64File(filename, base64) === true) return "download";
          } catch (err) { /* 落盘失败，退回浏览器路径 */ }
        }
      }

      try {
        const BlobCtor = typeof Blob !== "undefined" ? Blob : (win.Blob || null);
        const URLObj = typeof URL !== "undefined" ? URL : (win.URL || null);
        if (!BlobCtor || !URLObj || typeof URLObj.createObjectURL !== "function") return false;
        const blob = new BlobCtor([text], { type: `${mime};charset=utf-8` });
        const url = URLObj.createObjectURL(blob);
        const a = doc.createElement("a");
        a.href = url;
        a.download = filename;
        a.rel = "noopener";
        a.style.display = "none";
        doc.body.appendChild(a);
        a.click();
        later(() => {
          try {
            if (a.parentNode) a.parentNode.removeChild(a);
          } catch (err) { /* ignore */ }
          try { URLObj.revokeObjectURL(url); } catch (err) { /* ignore */ }
        }, 1500);
        return "browser";
      } catch (err) {
        return false;
      }
    }

    function downloadSavedText(fileName) {
      return shellSaver() ? `已保存到「下载」：${fileName}` : `已开始下载 ${fileName}`;
    }

    function copyText(text) {
      const nav = typeof navigator !== "undefined" ? navigator : (win.navigator || null);
      if (nav && nav.clipboard && typeof nav.clipboard.writeText === "function") {
        return nav.clipboard.writeText(text);
      }
      return new Promise((resolve, reject) => {
        try {
          const area = doc.createElement("textarea");
          area.value = text;
          area.style.position = "fixed";
          area.style.left = "-9999px";
          area.style.top = "0";
          doc.body.appendChild(area);
          area.focus();
          area.select();
          const ok = doc.execCommand ? doc.execCommand("copy") : false;
          if (area.parentNode) area.parentNode.removeChild(area);
          if (ok) resolve(); else reject(new Error("copy failed"));
        } catch (err) {
          reject(err);
        }
      });
    }

    function openExport(plugin, rerender) {
      activeTab = "normal";
      detailId = null;
      importView = false;
      exportId = plugin.manifest.id;
      exportInfoOpen = false;
      rerender();
    }

    function renderExport(body, plugin, rerender) {
      const back = element("button", "pmt-back", "‹ 插件列表");

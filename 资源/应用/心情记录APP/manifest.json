{
  "id": "mood.calendar",
  "name": "心情记录",
  "version": "1.2.0",
  "sdkVersion": "1.0",
  "author": "工坊",
  "description": "和 AI 角色共同记录心情、便签、备忘录与日记。日历标记心情、节日与纪念事项，备忘录双方共同维护待办，日记支持 AI 批注与总结。",
  "icon": "icon.svg",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "ai.generate",
    "chat.sendCard",
    "chat.requestReply",
    "chat.write",
    "chat.read",
    "chat.read.background",
    "chat.tools",
    "memory.readShortTerm",
    "memory.readLongTerm",
    "memory.search",
    "memory.write",
    "ui.toast",
    "ui.notification",
    "notifications.read",
    "notifications.write",
    "tasks.schedule",
    "user.profile.read"
  ],
  "resources": {
    "presets": [
      "presets.json"
    ],
    "regexes": [],
    "worldBooks": [],
    "bindings": [],
    "tools": [],
    "voices": [],
    "assets": [
      "icon.svg"
    ]
  },
  "primaryTags": [],
  "extensions": {
    "chat": {
      "plusActions": [
        {
          "id": "mood-open",
          "label": "心情记录",
          "description": "打开心情记录，记录你们的心情、备忘录与日记。",
          "entry": "calendar",
          "presentation": "fullscreen",
          "tags": []
        }
      ],
      "tools": [
        {
          "id": "record-mood",
          "name": "记录心情",
          "description": "把当前角色今天（或指定日期）的心情标记到「心情记录」日历上：一个表情符号，可选一段便签。仅在角色想记录心情、或用户要求时调用。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "日期 YYYY-MM-DD，不填默认今天"
              },
              "emoji": {
                "type": "string",
                "description": "单个表情符号"
              },
              "note": {
                "type": "string",
                "description": "可选便签，20-80字"
              }
            },
            "required": [
              "emoji"
            ]
          },
          "visibility": "shared",
          "handler": "recordMood"
        },
        {
          "id": "add-memory-item",
          "name": "添加纪念事项",
          "description": "在「心情记录」日历上添加一条纪念事项/纪念日/生日/生理期等标记。这是心情记录 APP 里的个人纪念标记，不是系统日程表。到当天会自动提醒并让角色记得。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "日期 YYYY-MM-DD"
              },
              "title": {
                "type": "string",
                "description": "标题，如 生日、纪念日"
              },
              "startTime": {
                "type": "string",
                "description": "可选 HH:MM"
              },
              "endTime": {
                "type": "string",
                "description": "可选 HH:MM"
              },
              "type": {
                "type": "string",
                "description": "anniversary/birthday/period_start/period_end/schedule/custom"
              }
            },
            "required": [
              "date",
              "title"
            ]
          },
          "visibility": "shared",
          "handler": "addSchedule"
        },
        {
          "id": "query-mood",
          "name": "查看心情记录",
          "description": "查询心情日历上某天或最近双方记录的心情、便签和纪念事项。仅在聊天过程中需要查看时调用。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD，不填查最近 7 天"
              }
            }
          },
          "visibility": "shared",
          "handler": "queryMood"
        },
        {
          "id": "view-memo",
          "name": "查看备忘录",
          "description": "查看「心情记录」里今天的备忘录待办清单（含未完成和已完成的事项）。用于聊天中了解待办情况。仅在需要了解待办时调用。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD，不填默认今天"
              }
            }
          },
          "visibility": "shared",
          "handler": "viewMemo"
        },
        {
          "id": "add-memo-item",
          "name": "添加待办",
          "description": "在「心情记录」备忘录里添加一条待办。每条不超过 10 字，每天最多 10 条。仅在角色想记录待办、或用户要求时调用，不要频繁添加。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD，不填默认今天"
              },
              "text": {
                "type": "string",
                "description": "待办内容，10 字以内"
              }
            },
            "required": [
              "text"
            ]
          },
          "visibility": "shared",
          "handler": "addMemo"
        },
        {
          "id": "complete-memo",
          "name": "完成待办",
          "description": "把「心情记录」备忘录里的一条待办标记为已完成（划掉）。仅在待办确实完成、或用户要求时调用。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD，不填默认今天"
              },
              "text": {
                "type": "string",
                "description": "要完成的待办内容，需与清单里某条一致"
              }
            },
            "required": [
              "text"
            ]
          },
          "visibility": "shared",
          "handler": "completeMemo"
        },
        {
          "id": "view-diary",
          "name": "查看日记",
          "description": "查看用户某天的日记。看完后，请调用「写日记批注」工具写出你的第三人称总结和感想。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD，不填默认今天"
              }
            }
          },
          "visibility": "shared",
          "handler": "viewDiary"
        },
        {
          "id": "comment-diary",
          "name": "写日记批注",
          "description": "在用户某天日记下方写一句简短感想/批注，并给出你对这篇日记的第三人称总结。只有看过该日记、或用户要求时才能写；同一天只写一次，已写过就不再重复。",
          "parameterSchema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD，不填默认今天"
              },
              "comment": {
                "type": "string",
                "description": "简短感想批注，60字以内"
              },
              "summary": {
                "type": "string",
                "description": "你对这篇日记的第三人称总结，如：用户今天心情如何、发生了什么，60字以内"
              }
            },
            "required": [
              "comment"
            ]
          },
          "visibility": "shared",
          "handler": "commentDiary"
        }
      ]
    },
    "tools": [
      {
        "id": "record-mood",
        "name": "记录心情",
        "description": "把当前角色今天（或指定日期）的心情标记到「心情记录」日历上：一个表情符号，可选一段便签。仅在角色想记录心情、或用户要求时调用。",

{
  "type": "ai-phone-game-draft",
  "version": 1,
  "title": "偷喝奶茶",
  "draft": {
    "title": "偷喝奶茶",
    "codeName": "✦",
    "subtitle": "",
    "synopsis": "",
    "playNote": "一款与小手机角色互动的趣味反应力小游戏。在角色忙碌时按住吸管偷喝奶茶，趁角色回头前喝完即可获胜。被抓包或喝完时会根据角色的真实人设与关系生成专属台词反馈，并记录入短期记忆。",
    "coverImage": "",
    "tagsText": "休闲",
    "authorName": "工坊",
    "roleSlotsText": "[]",
    "pickerHtml": "",
    "gameHtml": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n  <title>偷喝奶茶大作战</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      user-select: none;\n      -webkit-user-select: none;\n      -webkit-touch-callout: none;\n    }\n    :root {\n      --primary: #f59e0b;\n      --primary-dark: #d97706;\n      --bg: #fffbf0;\n      --card-bg: rgba(255, 255, 255, 0.92);\n      --text-main: #451a03;\n      --text-sub: #92400e;\n      --danger: #ef4444;\n      --safe: #10b981;\n    }\n    html, body {\n      width: 100%;\n      height: 100%;\n      background: var(--bg);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;\n      overflow: hidden;\n      color: var(--text-main);\n    }\n    .game-screen {\n      width: 100%;\n      height: 100%;\n      padding: var(--ai-phone-game-safe-top, 88px) 16px var(--ai-phone-game-safe-bottom, 20px);\n      display: flex;\n      flex-direction: column;\n      position: relative;\n      background: radial-gradient(circle at 50% 20%, #fef3c7 0%, #fffbf0 70%);\n    }\n\n    /* 模式选择主封面视图 */\n    .mode-view {\n      position: absolute;\n      inset: 0;\n      padding: var(--ai-phone-game-safe-top, 88px) 20px var(--ai-phone-game-safe-bottom, 24px);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: space-between;\n      background: radial-gradient(circle at 50% 25%, #fef08a 0%, #fffbf0 70%);\n      z-index: 20;\n      transition: opacity 0.25s ease, transform 0.25s ease;\n    }\n    .mode-view.hidden {\n      opacity: 0;\n      pointer-events: none;\n      transform: scale(0.96);\n    }\n\n    .cover-header {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 6px;\n      margin-top: 10px;\n    }\n    .cover-icon {\n      font-size: 48px;\n      animation: floatCup 1.8s infinite alternate ease-in-out;\n    }\n    @keyframes floatCup {\n      from { transform: translateY(0) rotate(-3deg); }\n      to { transform: translateY(-8px) rotate(3deg); }\n    }\n    .cover-title {\n      font-size: 24px;\n      font-weight: 900;\n      color: #78350f;\n      letter-spacing: 0.5px;\n    }\n    .cover-sub {\n      font-size: 13px;\n      color: #b45309;\n      font-weight: 600;\n    }\n\n    /* 角色选择胶囊 */\n    .cover-char-btn {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      background: rgba(255, 255, 255, 0.9);\n      padding: 6px 14px 6px 8px;\n      border-radius: 999px;\n      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.15);\n      border: 1.5px solid rgba(245, 158, 11, 0.3);\n      cursor: pointer;\n      margin-top: 4px;\n    }\n    .cover-char-avatar {\n      width: 32px;\n      height: 32px;\n      border-radius: 50%;\n      object-fit: cover;\n      border: 2px solid #fff;\n    }\n    .cover-char-name {\n      font-size: 14px;\n      font-weight: 800;\n      color: var(--text-main);\n      max-width: 140px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    /* 模式卡片列表 */\n    .mode-cards {\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      margin: auto 0;\n    }\n    .mode-card {\n      width: 100%;\n      background: #ffffff;\n      border-radius: 20px;\n      padding: 14px 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border: 2px solid #fef08a;\n      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.08);\n      cursor: pointer;\n      transition: all 0.15s ease;\n      position: relative;\n      overflow: hidden;\n    }\n    .mode-card:active {\n      transform: scale(0.97);\n      background: #fffbeb;\n      border-color: #f59e0b;\n    }\n    .mode-info {\n      display: flex;\n      flex-direction: column;\n      gap: 3px;\n      text-align: left;\n    }\n    .mode-title-row {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .mode-tag {\n      font-size: 10px;\n      font-weight: 800;\n      padding: 2px 6px;\n      border-radius: 6px;\n    }\n    .mode-tag.easy { background: #dcfce7; color: #15803d; }\n    .mode-tag.normal { background: #fef3c7; color: #b45309; }\n    .mode-tag.hard { background: #fee2e2; color: #b91c1c; }\n\n    .mode-name {\n      font-size: 16px;\n      font-weight: 800;\n      color: #451a03;\n    }\n    .mode-desc {\n      font-size: 11px;\n      color: #92400e;\n      line-height: 1.35;\n    }\n    .mode-arrow {\n      font-size: 18px;\n      color: #d97706;\n      font-weight: 900;\n    }\n\n    /* 游戏主对局视图 */\n    .play-view {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      position: relative;\n    }\n    .play-view.hidden {\n      display: none;\n    }\n\n    /* 对局顶部栏 */\n    .top-bar {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 6px;\n    }\n    .char-badge {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      background: var(--card-bg);\n      padding: 4px 10px 4px 6px;\n      border-radius: 999px;\n      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.12);\n      border: 1px solid rgba(245, 158, 11, 0.2);\n    }\n    .char-avatar {\n      width: 26px;\n      height: 26px;\n      border-radius: 50%;\n      object-fit: cover;\n      background: #fde68a;\n      border: 1.5px solid #fff;\n    }\n    .char-name {\n      font-size: 13px;\n      font-weight: 700;\n      color: var(--text-main);\n      max-width: 90px;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .diff-badge-btn {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      font-size: 11px;\n      font-weight: 800;\n      padding: 4px 10px;\n      border-radius: 999px;\n      border: 1px solid rgba(245, 158, 11, 0.25);\n      background: rgba(255, 255, 255, 0.85);\n      color: var(--primary-dark);\n      cursor: pointer;\n      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.1);\n    }\n\n    /* 主场景展示区 */\n    .stage-container {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: space-between;\n      position: relative;\n      min-height: 0;\n    }\n\n    /* 角色观察区 */\n    .character-area {\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      position: relative;\n      margin-top: 4px;\n    }\n    .dialog-bubble {\n      position: absolute;\n      top: -26px;\n      background: #ffffff;\n      padding: 5px 12px;\n      border-radius: 16px;\n      font-size: 12px;\n      font-weight: 600;\n      color: var(--text-main);\n      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);\n      border: 1.5px solid #fef08a;\n      opacity: 0;\n      transform: translateY(6px) scale(0.95);\n      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);\n      pointer-events: none;\n      z-index: 10;\n      max-width: 85%;\n      text-align: center;\n    }\n    .dialog-bubble.show {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n    .dialog-bubble::after {\n      content: '';\n      position: absolute;\n      bottom: -6px;\n      left: 50%;\n      transform: translateX(-50%);\n      border-width: 6px 6px 0;\n      border-style: solid;\n      border-color: #ffffff transparent;\n      display: block;\n      width: 0;\n    }\n\n    /* 角色立绘/状态展示 */\n    .char-visual {\n      width: 110px;\n      height: 110px;\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .char-portrait {\n      width: 86px;\n      height: 86px;\n      border-radius: 50%;\n      object-fit: cover;\n      border: 3px solid #f59e0b;\n      box-shadow: 0 6px 18px rgba(180, 83, 9, 0.2);\n      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n    }\n    .state-indicator {\n      position: absolute;\n      top: 0px;\n      right: 4px;\n      font-size: 22px;\n      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));\n      animation: bounce 0.6s infinite alternate ease-in-out;\n    }\n    @keyframes bounce {\n      from { transform: translateY(0); }\n      to { transform: translateY(-6px); }\n    }\n\n    .char-visual.busy .char-portrait {\n      filter: brightness(0.92);\n      transform: scale(0.96) rotate(-4deg);\n    }\n    .char-visual.alert .char-portrait {\n      border-color: #f59e0b;\n      transform: scale(1.04) rotate(3deg);\n    }\n    .char-visual.looking .char-portrait {\n      border-color: var(--danger);\n      box-shadow: 0 0 20px rgba(239, 68, 68, 0.45);\n      transform: scale(1.1);\n      animation: shake 0.2s infinite ease-in-out;\n    }\n    @keyframes shake {\n      0%, 100% { transform: scale(1.1) translate(0, 0); }\n      50% { transform: scale(1.1) translate(-2px, 1px); }\n    }\n\n    .state-label {\n      margin-top: 4px;\n      font-size: 12px;\n      font-weight: 700;\n      padding: 3px 12px;\n      border-radius: 999px;\n      background: #e2e8f0;\n      color: #64748b;\n      transition: all 0.2s ease;\n    }\n    .state-label.busy { background: #dcfce7; color: #15803d; }\n    .state-label.alert { background: #fef3c7; color: #b45309; animation: pulseAlert 0.4s infinite alternate ease-in-out; }\n    .state-label.looking { background: #fee2e2; color: #b91c1c; font-weight: 800; }\n    @keyframes pulseAlert {\n      from { transform: scale(1); }\n      to { transform: scale(1.05); }\n    }\n\n    /* 奶茶杯与桌面 */\n    .boba-area {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      position: relative;\n      margin-bottom: 4px;\n    }\n    .boba-cup-wrap {\n      width: 104px;\n      height: 148px;\n      position: relative;\n      display: flex;\n      justify-content: center;\n      align-items: flex-end;\n    }\n    .straw {\n      position: absolute;\n      top: 0px;\n      width: 13px;\n      height: 148px;\n      background: repeating-linear-gradient(45deg, #ef4444, #ef4444 8px, #fff 8px, #fff 16px);\n      border-radius: 6px;\n      transform: rotate(10deg);\n      z-index: 5;\n      box-shadow: 1px 2px 6px rgba(0,0,0,0.15);\n      transition: transform 0.1s ease;\n    }\n    .straw.drinking {\n      animation: strawDrink 0.15s infinite alternate ease-in-out;\n    }\n    @keyframes strawDrink {\n      from { transform: rotate(10deg) translateY(0); }\n      to { transform: rotate(10deg) translateY(3px); }\n    }\n    .cup-body {\n      width: 90px;\n      height: 120px;\n      background: rgba(255, 255, 255, 0.4);\n      border: 3px solid rgba(255, 255, 255, 0.85);\n      border-top: none;\n      border-radius: 0 0 22px 22px;\n      position: relative;\n      overflow: hidden;\n      backdrop-filter: blur(4px);\n      box-shadow: inset 0 -4px 12px rgba(0,0,0,0.06), 0 8px 24px rgba(217, 119, 6, 0.15);\n    }\n    .cup-lid {\n      position: absolute;\n      top: 24px;\n      width: 98px;\n      height: 10px;\n      background: #fbbf24;\n      border-radius: 5px;\n      z-index: 6;\n      border: 2px solid #f59e0b;\n    }\n    .liquid {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background: linear-gradient(180deg, #d97706 0%, #b45309 100%);\n      transition: height 0.08s linear;\n      display: flex;\n      flex-direction: column-reverse;\n      align-items: center;\n    }\n    .pearls-layer {\n      width: 100%;\n      height: 36px;\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 3px;\n      padding: 3px;\n      opacity: 0.9;\n    }\n    .pearl {\n      width: 9px;\n      height: 9px;\n      background: #1c1917;\n      border-radius: 50%;\n      box-shadow: inset -1px -1px 2px rgba(255,255,255,0.3);\n    }\n    .tea-stat {\n      margin-top: 4px;\n      font-size: 12px;\n      font-weight: 700;\n      color: var(--text-sub);\n    }\n\n    /* 呛咳计量条 */\n    .choke-meter-wrap {\n      width: 85%;\n      margin: 4px 0 2px;\n      display: none;\n      flex-direction: column;\n      gap: 3px;\n    }\n    .choke-meter-wrap.active {\n      display: flex;\n    }\n    .choke-label-row {\n      display: flex;\n      justify-content: space-between;\n      font-size: 11px;\n      font-weight: 700;\n      color: #0369a1;\n    }\n    .choke-track {\n      width: 100%;\n      height: 7px;\n      background: rgba(3, 105, 161, 0.15);\n      border-radius: 999px;\n      overflow: hidden;\n      position: relative;\n    }\n    .choke-bar {\n      height: 100%;\n      width: 0%;\n      background: linear-gradient(90deg, #38bdf8 0%, #0284c7 70%, #ef4444 100%);\n      transition: width 0.05s linear;\n      border-radius: 999px;\n    }\n\n    /* 底部操作区 */\n    .controls {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 6px;\n      margin-top: auto;\n      width: 100%;\n    }\n    .drink-btn {\n      width: 100%;\n      height: 52px;\n      border-radius: 16px;\n      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);\n      color: #fff;\n      font-size: 17px;\n      font-weight: 800;\n      border: none;\n      box-shadow: 0 6px 18px rgba(217, 119, 6, 0.35);\n      cursor: pointer;\n      outline: none;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      transition: transform 0.08s ease, box-shadow 0.08s ease;\n      -webkit-tap-highlight-color: transparent;\n    }\n    .drink-btn:active, .drink-btn.pressed {\n      transform: scale(0.96);\n      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);\n      box-shadow: 0 2px 8px rgba(217, 119, 6, 0.25);\n    }\n    .drink-hint {\n      font-size: 11px;\n      color: #a16207;\n      font-weight: 500;\n      text-align: center;\n    }\n\n    /* 结算弹窗 */\n    .modal-backdrop {\n      position: absolute;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.55);\n      backdrop-filter: blur(6px);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n      z-index: 100;\n      opacity: 0;\n      pointer-events: none;\n      transition: opacity 0.25s ease;\n    }\n    .modal-backdrop.active {\n      opacity: 1;\n      pointer-events: auto;\n    }\n    .result-card {\n      width: 100%;\n      background: #ffffff;\n      border-radius: 24px;\n      padding: 20px 18px;\n      text-align: center;\n      box-shadow: 0 12px 36px rgba(0,0,0,0.25);\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      transform: translateY(20px) scale(0.95);\n      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n    }\n    .modal-backdrop.active .result-card {\n      transform: translateY(0) scale(1);\n    }\n    .res-emoji {\n      font-size: 40px;\n    }\n    .res-title {\n      font-size: 19px;\n      font-weight: 800;\n    }\n    .res-title.win { color: #15803d; }\n    .res-title.busted { color: #b91c1c; }\n    .res-title.choked { color: #0284c7; }\n    .res-quote {\n      background: #f8fafc;\n      border-radius: 14px;\n      padding: 12px;\n      font-size: 13px;\n      line-height: 1.5;\n      color: #334155;\n      border-left: 3px solid #f59e0b;\n      text-align: left;\n      min-height: 48px;\n      display: flex;\n      align-items: center;\n    }\n    .res-quote.loading {\n      font-style: italic;\n      color: #94a3b8;\n    }\n    .res-actions {\n      display: flex;\n      gap: 10px;\n      margin-top: 4px;\n    }\n    .btn-action {\n      flex: 1;\n      height: 44px;\n      border-radius: 14px;\n      font-size: 14px;\n      font-weight: 700;\n      border: none;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 4px;\n    }\n    .btn-restart {\n      background: #f59e0b;\n      color: #fff;\n      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);\n    }\n    .btn-switch {\n      background: #f1f5f9;\n      color: #475569;\n    }\n\n    /* 选人弹窗 */\n    .char-select-list {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      max-height: 220px;\n      overflow-y: auto;\n      padding: 4px;\n    }\n    .char-select-item {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 8px 12px;\n      border-radius: 12px;\n      background: #f8fafc;\n      border: 1px solid #e2e8f0;\n      cursor: pointer;\n      text-align: left;\n      transition: background 0.15s ease;\n    }\n    .char-select-item:active {\n      background: #fef3c7;\n    }\n    .char-select-avatar {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"game-screen\">\n    <!-- 模式选择入口封面 -->\n    <div id=\"modeView\" class=\"mode-view\">\n      <div class=\"cover-header\">\n        <div class=\"cover-icon\">🧋</div>\n        <div class=\"cover-title\">偷喝奶茶大作战</div>\n        <div class=\"cover-sub\">趁角色不注意，悄悄吸光奶茶！</div>\n        <div class=\"cover-char-btn\" id=\"coverCharBtn\">\n          <img id=\"coverAvatar\" class=\"cover-char-avatar\" src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><circle cx='20' cy='20' r='20' fill='%23fef08a'/><text x='20' y='25' font-size='18' text-anchor='middle' fill='%23b45309'>🧋</text></svg>\" />\n          <span id=\"coverName\" class=\"cover-char-name\">选择角色</span>\n          <span style=\"font-size:11px; color:#b45309;\">⇄</span>\n        </div>\n      </div>\n\n      <div class=\"mode-cards\">\n        <button type=\"button\" class=\"mode-card\" data-mode=\"easy\">\n          <div class=\"mode-info\">\n            <div class=\"mode-title-row\">\n              <span class=\"mode-tag easy\">EASY</span>\n              <span class=\"mode-name\">简单模式 · 小杯</span>\n            </div>\n            <div class=\"mode-desc\">标准奶茶量 | 角色反应较慢 | 无呛咳机制</div>\n          </div>\n          <div class=\"mode-arrow\">➔</div>\n        </button>\n\n        <button type=\"button\" class=\"mode-card\" data-mode=\"normal\">\n          <div class=\"mode-info\">\n            <div class=\"mode-title-row\">\n              <span class=\"mode-tag normal\">NORMAL</span>\n              <span class=\"mode-name\">普通模式 · 中杯</span>\n            </div>\n            <div class=\"mode-desc\">1.5倍奶茶量 | 启用急躁度计量（连吸会呛到）</div>\n          </div>\n          <div class=\"mode-arrow\">➔</div>\n        </button>\n\n        <button type=\"button\" class=\"mode-card\" data-mode=\"hard\">\n          <div class=\"mode-info\">\n            <div class=\"mode-title-row\">\n              <span class=\"mode-tag hard\">HARD</span>\n              <span class=\"mode-name\">困难模式 · 超大杯</span>\n            </div>\n            <div class=\"mode-desc\">2.0倍奶茶量 | 听觉极敏锐 | 极易呛咳暴露</div>\n          </div>\n          <div class=\"mode-arrow\">➔</div>\n        </button>\n      </div>\n\n      <div style=\"font-size:11px; color:#92400e; font-weight:600; text-align:center;\">\n        💡 成功喝完或被抓包时，角色会根据真实人设生成专属台词\n      </div>\n    </div>\n\n    <!-- 对局视图 -->\n    <div id=\"playView\" class=\"play-view hidden\">\n      <!-- 顶部状态栏 -->\n      <div class=\"top-bar\">\n        <div class=\"char-badge\" id=\"charBadgeBtn\">\n          <img id=\"topAvatar\" class=\"char-avatar\" src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><circle cx='20' cy='20' r='20' fill='%23fef08a'/><text x='20' y='25' font-size='18' text-anchor='middle' fill='%23b45309'>🧋</text></svg>\" />\n          <span id=\"topName\" class=\"char-name\">选择角色</span>\n          <span style=\"font-size:10px; color:#92400e;\">⇄</span>\n        </div>\n\n        <button id=\"diffBadgeBtn\" class=\"diff-badge-btn\">\n          <span id=\"diffBadgeText\">简单模式</span>\n          <span style=\"font-size:9px;\">⟲</span>\n        </button>\n      </div>\n\n      <!-- 主舞台 -->\n      <div class=\"stage-container\">\n        <!-- 角色表现 -->\n        <div class=\"character-area\">\n          <div id=\"dialogBubble\" class=\"dialog-bubble\">玩手机中...</div>\n          <div id=\"charVisual\" class=\"char-visual busy\">\n            <img id=\"charPortrait\" class=\"char-portrait\" src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50' fill='%23fde68a'/><text x='50' y='60' font-size='42' text-anchor='middle' fill='%23b45309'>🐱</text></svg>\" />\n            <div id=\"stateIndicator\" class=\"state-indicator\">📱</div>\n          </div>\n          <div id=\"stateLabel\" class=\"state-label busy\">沉迷玩手机</div>\n        </div>\n\n        <!-- 奶茶展示区 -->\n        <div class=\"boba-area\">\n          <div class=\"boba-cup-wrap\">\n            <div id=\"straw\" class=\"straw\"></div>\n            <div class=\"cup-lid\"></div>\n            <div class=\"cup-body\">\n              <div id=\"liquid\" class=\"liquid\" style=\"height: 100%;\">\n                <div class=\"pearls-layer\">\n                  <div class=\"pearl\"></div><div class=\"pearl\"></div><div class=\"pearl\"></div>\n                  <div class=\"pearl\"></div><div class=\"pearl\"></div><div class=\"pearl\"></div>\n                  <div class=\"pearl\"></div><div class=\"pearl\"></div><div class=\"pearl\"></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"tea-stat\">奶茶剩余: <span id=\"percentVal\">100</span>%</div>\n        </div>\n\n        <!-- 呛咳计量条（普通/困难生效） -->\n        <div id=\"chokeMeterWrap\" class=\"choke-meter-wrap\">\n          <div class=\"choke-label-row\">\n            <span>🫁 吸入急躁度</span>\n            <span id=\"chokePercentText\">0%</span>\n          </div>\n          <div class=\"choke-track\">\n            <div id=\"chokeBar\" class=\"choke-bar\"></div>\n          </div>\n        </div>\n\n        <!-- 底部长按控制 -->\n        <div class=\"controls\">\n          <button id=\"drinkBtn\" class=\"drink-btn\">\n            <span>🧋 长按偷喝大吸一口！</span>\n          </button>\n          <div id=\"drinkHint\" class=\"drink-hint\">⚠️ 角色回头（👀）时吸入立即被抓！</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 结算模态窗 -->\n    <div id=\"resultModal\" class=\"modal-backdrop\">\n      <div class=\"result-card\">\n        <div id=\"resEmoji\" class=\"res-emoji\">🎉</div>\n        <div id=\"resTitle\" class=\"res-title win\">大获全胜！</div>\n        <div id=\"resQuote\" class=\"res-quote loading\">正在观察角色的反应...</div>\n        <div class=\"res-actions\">\n          <button id=\"btnRestart\" class=\"btn-action btn-restart\">再来一杯</button>\n          <button id=\"btnSwitch\" class=\"btn-action btn-switch\">换模式/角色</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 选人模态窗 -->\n    <div id=\"selectModal\" class=\"modal-backdrop\">\n      <div class=\"result-card\">\n        <div class=\"res-title\" style=\"font-size:16px; color:#451a03;\">选择要偷喝谁的奶茶</div>\n        <div id=\"charSelectList\" class=\"char-select-list\"></div>\n        <button id=\"closeSelectBtn\" class=\"btn-action btn-switch\" style=\"margin-top:8px;\">取消</button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const STATES = {\n      BUSY: 'busy',\n      ALERT: 'alert',\n      LOOKING: 'looking'\n    };\n\n    const DIFF_CONFIG = {\n      easy: {\n        name: '简单模式',\n        capacityMultiplier: 1.0,\n        alertDurationMin: 700,\n        alertDurationMax: 1000,\n        busyDurationMin: 1800,\n        busyDurationMax: 3200,\n        hasChoke: false,\n        hint: '⚠️ 角色回头（👀）时吸入立即被抓！'\n      },\n      normal: {\n        name: '普通模式',\n        capacityMultiplier: 1.5,\n        alertDurationMin: 550,\n        alertDurationMax: 850,\n        busyDurationMin: 1500,\n        busyDurationMax: 2800,\n        hasChoke: true,\n        chokeGainSpeed: 2.7,         // 量程砍半（上涨速度翻倍，约 1.1 秒不松手即呛到）\n        chokeDecaySpeed: 2.2,        // 松手快速回落\n        hint: '⚠️ 狂吸急躁度满了会呛咳暴露！吸两口需停顿'\n      },\n      hard: {\n        name: '困难模式',\n        capacityMultiplier: 2.0,\n        alertDurationMin: 380,\n        alertDurationMax: 600,\n        busyDurationMin: 1100,\n        busyDurationMax: 2000,\n        hasChoke: true,\n        chokeGainSpeed: 3.6,         // 量程砍半（上涨极快，约 0.8 秒必须松手）\n        chokeDecaySpeed: 1.8,\n        hint: '⚠️ 角色听觉极敏锐！急躁度极容易爆表！'\n      }\n    };\n\n    let currentDifficulty = 'easy';\n    let selectedCharacter = null;\n    let playerName = '我';\n    let maxVolume = 100;\n    let currentVolume = 100;\n    let chokeValue = 0;\n    let currentState = STATES.BUSY;\n    let isDrinking = false;\n    let isGameOver = false;\n    let stateTimer = null;\n    let loopInterval = null;\n    let availableCharacters = [];\n\n    // DOM\n    const modeView = document.getElementById('modeView');\n    const playView = document.getElementById('playView');\n    const coverCharBtn = document.getElementById('coverCharBtn');\n    const coverAvatar = document.getElementById('coverAvatar');\n    const coverName = document.getElementById('coverName');\n    const modeCards = document.querySelectorAll('.mode-card');\n    const diffBadgeBtn = document.getElementById('diffBadgeBtn');\n    const diffBadgeText = document.getElementById('diffBadgeText');\n\n    const charBadgeBtn = document.getElementById('charBadgeBtn');\n    const topAvatar = document.getElementById('topAvatar');\n    const topName = document.getElementById('topName');\n    const charVisual = document.getElementById('charVisual');\n    const charPortrait = document.getElementById('charPortrait');\n    const stateIndicator = document.getElementById('stateIndicator');\n    const stateLabel = document.getElementById('stateLabel');\n    const dialogBubble = document.getElementById('dialogBubble');\n    const straw = document.getElementById('straw');\n    const liquid = document.getElementById('liquid');\n    const percentVal = document.getElementById('percentVal');\n    const drinkBtn = document.getElementById('drinkBtn');\n    const drinkHint = document.getElementById('drinkHint');\n    const chokeMeterWrap = document.getElementById('chokeMeterWrap');\n    const chokeBar = document.getElementById('chokeBar');\n    const chokePercentText = document.getElementById('chokePercentText');\n    const resultModal = document.getElementById('resultModal');\n    const resEmoji = document.getElementById('resEmoji');\n    const resTitle = document.getElementById('resTitle');\n    const resQuote = document.getElementById('resQuote');\n    const btnRestart = document.getElementById('btnRestart');\n    const btnSwitch = document.getElementById('btnSwitch');\n    const selectModal = document.getElementById('selectModal');\n    const charSelectList = document.getElementById('charSelectList');\n    const closeSelectBtn = document.getElementById('closeSelectBtn');\n\n    async function initHost() {\n      if (window.AiPhoneGame) {\n        try {\n          await AiPhoneGame.setTitleBar({\n            material: 'glass',\n            buttonBackground: 'rgba(255, 255, 255, 0.7)',\n            buttonColor: '#92400e',\n            buttonBorderColor: 'rgba(245, 158, 11, 0.25)',\n            buttonRadius: '999px'\n          });\n        } catch(e) {}\n\n        try {\n          const player = await AiPhoneGame.getPlayerProfile();\n          if (player && player.name) playerName = player.name;\n        } catch(e) {}\n\n        try {\n          availableCharacters = await AiPhoneGame.listAvailableCharacters();\n        } catch(e) {}\n      }\n\n      if (availableCharacters && availableCharacters.length > 0) {\n        setCharacter(availableCharacters[0]);\n      } else {\n        setCharacter({ id: 'default_char', name: '猫猫店长', avatar: '' });\n      }\n\n      startMainGameLoop();\n    }\n\n    function setCharacter(char) {\n      selectedCharacter = char;\n      topName.textContent = char.name || 'AI角色';\n      coverName.textContent = char.name || 'AI角色';\n      if (char.avatar) {\n        topAvatar.src = char.avatar;\n        charPortrait.src = char.avatar;\n        coverAvatar.src = char.avatar;\n      } else {\n        const defaultSvg = \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50' fill='%23fde68a'/><text x='50' y='62' font-size='46' text-anchor='middle' fill='%23b45309'>🐱</text></svg>\";\n        topAvatar.src = defaultSvg;\n        charPortrait.src = defaultSvg;\n        coverAvatar.src = defaultSvg;\n      }\n    }\n\n    // 点击封面模式卡片进入对局（兼容 touch/click）\n    document.querySelectorAll('.mode-card').forEach(card => {\n      const handleSelect = (e) => {\n        if (e) { e.preventDefault(); e.stopPropagation(); }\n        const diff = card.getAttribute('data-mode') || 'easy';\n        startGameWithDifficulty(diff);\n      };\n      card.addEventListener('click', handleSelect);\n      card.addEventListener('touchend', handleSelect, { passive: false });\n    });\n\n    function startGameWithDifficulty(diff) {\n      currentDifficulty = diff;\n      diffBadgeText.textContent = DIFF_CONFIG[diff].name;\n      modeView.classList.add('hidden');\n      playView.classList.remove('hidden');\n      resetGame();\n    }\n\n    function backToModeSelect() {\n      isGameOver = true;\n      isDrinking = false;\n      clearTimeout(stateTimer);\n      resultModal.classList.remove('active');\n      playView.classList.add('hidden');\n      modeView.classList.remove('hidden');\n    }\n\n    function scheduleNextState() {\n      if (isGameOver) return;\n      clearTimeout(stateTimer);\n      const conf = DIFF_CONFIG[currentDifficulty];\n\n      if (currentState === STATES.BUSY) {\n        const duration = conf.busyDurationMin + Math.random() * (conf.busyDurationMax - conf.busyDurationMin);\n        stateTimer = setTimeout(() => setState(STATES.ALERT), duration);\n      } else if (currentState === STATES.ALERT) {\n        const duration = conf.alertDurationMin + Math.random() * (conf.alertDurationMax - conf.alertDurationMin);\n        stateTimer = setTimeout(() => setState(STATES.LOOKING), duration);\n      } else if (currentState === STATES.LOOKING) {\n        const duration = 1200 + Math.random() * 800;\n        stateTimer = setTimeout(() => setState(STATES.BUSY), duration);\n      }\n    }\n\n    function setState(newState) {\n      if (isGameOver) return;\n      currentState = newState;\n      charVisual.className = `char-visual ${newState}`;\n      stateLabel.className = `state-label ${newState}`;\n\n      if (newState === STATES.BUSY) {\n        const busyActions = ['📱 刷短视频', '📖 认真看书', '💭 发呆走神', '🎵 听音乐中', '✍️ 整理随笔'];\n        const randomAction = busyActions[Math.floor(Math.random() * busyActions.length)];\n        stateIndicator.textContent = randomAction.split(' ')[0];\n        stateLabel.textContent = randomAction.split(' ')[1];\n        hideBubble();\n      } else if (newState === STATES.ALERT) {\n        stateIndicator.textContent = '❓';\n        stateLabel.textContent = '嗯？听到动静...';\n        showBubble(currentDifficulty === 'hard' ? '（耳朵微动）' : '好像有吸管声？');\n      } else if (newState === STATES.LOOKING) {\n        stateIndicator.textContent = '👀';\n        stateLabel.textContent = '回头盯——！！';\n        showBubble('盯————————！');\n        if (isDrinking) {\n          onBusted();\n          return;\n        }\n      }\n      scheduleNextState();\n    }\n\n    function showBubble(text) {\n      dialogBubble.textContent = text;\n      dialogBubble.classList.add('show');\n    }\n    function hideBubble() {\n      dialogBubble.classList.remove('show');\n    }\n\n    function startMainGameLoop() {\n      clearInterval(loopInterval);\n      loopInterval = setInterval(() => {\n        if (isGameOver || playView.classList.contains('hidden')) return;\n        const conf = DIFF_CONFIG[currentDifficulty];\n\n        if (isDrinking) {\n          if (currentState === STATES.LOOKING) {\n            onBusted();\n            return;\n          }\n\n          currentVolume = Math.max(0, currentVolume - 0.7);\n          updateTeaUI();\n\n          if (conf.hasChoke) {\n            chokeValue = Math.min(100, chokeValue + conf.chokeGainSpeed);\n            updateChokeUI();\n            if (chokeValue >= 100) {\n              onChoked();\n              return;\n            }\n          }\n\n          if (currentVolume <= 0) {\n            onWin();\n            return;\n          }\n        } else {\n          if (conf.hasChoke && chokeValue > 0) {\n            chokeValue = Math.max(0, chokeValue - conf.chokeDecaySpeed);\n            updateChokeUI();\n          }\n        }\n      }, 30);\n    }\n\n    function startDrinking(e) {\n      if (e) e.preventDefault();\n      if (isGameOver || playView.classList.contains('hidden')) return;\n      if (isDrinking) return;\n\n      isDrinking = true;\n      drinkBtn.classList.add('pressed');\n      straw.classList.add('drinking');\n\n      if (currentState === STATES.LOOKING) {\n        onBusted();\n      }\n    }\n\n    function stopDrinking(e) {\n      if (e) e.preventDefault();\n      isDrinking = false;\n      drinkBtn.classList.remove('pressed');\n      straw.classList.remove('drinking');\n    }\n\n    function updateTeaUI() {\n      const pct = (currentVolume / maxVolume) * 100;\n      liquid.style.height = `${pct}%`;\n      percentVal.textContent = Math.round(pct);\n    }\n\n    function updateChokeUI() {\n      chokeBar.style.width = `${chokeValue}%`;\n      chokePercentText.textContent = `${Math.round(chokeValue)}%`;\n    }\n\n    async function onChoked() {\n      if (isGameOver) return;\n      isGameOver = true;\n      stopDrinking();\n      clearTimeout(stateTimer);\n\n      resEmoji.textContent = '😫';\n      resTitle.textContent = '咳咳！狂吸太急呛到了！';\n      resTitle.className = 'res-title choked';\n      resQuote.textContent = '听到你一阵剧烈咳嗽，角色连忙回头看你...';\n      resQuote.className = 'res-quote loading';\n      resultModal.classList.add('active');\n\n      const quote = await generateQuote('choked');\n      resQuote.textContent = `“${quote}”`;\n      resQuote.className = 'res-quote';\n\n      recordEvent('choked', quote);\n    }\n\n    async function onBusted() {\n      if (isGameOver) return;\n      isGameOver = true;\n      stopDrinking();\n      clearTimeout(stateTimer);\n\n      resEmoji.textContent = '🚨';\n      resTitle.textContent = '被当场抓包！';\n      resTitle.className = 'res-title busted';\n      resQuote.textContent = '正在等待被抓现行后的反应...';\n      resQuote.className = 'res-quote loading';\n      resultModal.classList.add('active');\n\n      const quote = await generateQuote('busted');\n      resQuote.textContent = `“${quote}”`;\n      resQuote.className = 'res-quote';\n\n      recordEvent('busted', quote);\n    }\n\n    async function onWin() {\n      if (isGameOver) return;\n      isGameOver = true;\n      stopDrinking();\n      clearTimeout(stateTimer);\n\n      resEmoji.textContent = '🎉';\n      resTitle.textContent = '神不知鬼不觉喝完啦！';\n      resTitle.className = 'res-title win';\n      resQuote.textContent = '角色回头发现奶茶空了...';\n      resQuote.className = 'res-quote loading';\n      resultModal.classList.add('active');\n\n      const quote = await generateQuote('win');\n      resQuote.textContent = `“${quote}”`;\n      resQuote.className = 'res-quote';\n\n      recordEvent('win', quote);\n    }\n\n    async function generateQuote(type) {\n      const charName = selectedCharacter ? selectedCharacter.name : '对方';\n      const isRealChar = selectedCharacter && selectedCharacter.id !== 'default_char';\n\n      let userActionPrompt = '';\n      if (type === 'busted') {\n        userActionPrompt = `（趁你正在专注做事，我悄悄凑过去咬住你桌上的奶茶吸管偷喝……你这时刚好回过头来，两人的目光直接撞在一起，我嘴里还含着你的吸管）`;\n      } else if (type === 'win') {\n        userActionPrompt = `（趁你没注意，我已经把你杯子里的奶茶全部喝光了，空杯原样放回你手边。你忙完随手拿起杯子咬住吸管吸了一口，吸管里只发出吸空的空气声）`;\n      } else if (type === 'choked') {\n        userActionPrompt = `（我趁你不注意偷喝你的奶茶，结果太急一下子呛到了，捂着胸口在你身旁剧烈咳嗽“咳咳咳！”，你连忙放下手里的事转过头来看我）`;\n      }\n\n      const systemPrompt = `【小剧场实时互动 · 角色核心准则】\n你现在正在以你的原本角色身份（${charName}）与${playerName}当面实时互动。\n1. 【严格遵循人设与实际关系】：\n   - 必须完全基于角色卡中的人设、性格特质、语言风格、年龄感与心理成熟度；\n   - 必须严格遵从你与${playerName}的实际身份差、辈分与既定关系（例如：年上/长辈/成熟者请保持年上的包容、无奈宠溺、温和关照或长辈式关切；上位者保持气场；同龄/恋人/朋友等各自遵从原设），绝不可套用任何刻板标签。\n2. 【绝对违禁词与八股句式（严禁出现）】：\n   - 严禁霸总/油腻烂梗：【过来】、【算账】、【欠账】、【利息】、【买单】、【惩罚你】、【小东西】、【小野猫】、【胆子大了】、【负责】、【偿还】；\n   - 严禁套路威胁句式：【要是你……我就……】、【你再……我就……】、【你不……我就……】、【你敢……我就……】、【要是你xxx，我可不负责……】。\n   - 必须使用自然、真实、符合角色的生活化口吻。\n3. 【输出规范】：\n   - 这是现场面对${playerName}时的第一反应脱口而出；\n   - 仅输出 1 句直接台词（35字以内），严禁带有任何动作描写、括号旁白、心理活动或多余引号。`;\n\n      if (window.AiPhoneGame) {\n        try {\n          if (isRealChar) {\n            const pkg = await (AiPhoneGame.getRoleFullPackage ? AiPhoneGame.getRoleFullPackage(selectedCharacter.id) : AiPhoneGame.getRoleLightPackage(selectedCharacter.id));\n            const res = await AiPhoneGame.callLLM({\n              characterId: selectedCharacter.id,\n              messages: [\n                ...pkg.messages,\n                { role: 'system', content: systemPrompt },\n                { role: 'user', content: userActionPrompt }\n              ]\n            });\n\n            if (res && res.content) {\n              let cleaned = res.content.trim()\n                .replace(/^[\"“「『]|[\"”」』]$/g, '')\n                .replace(/（[^）]*）|\\([^)]*\\)/g, '')\n                .replace(/【[^】]*】|\\[[^\\]]*\\]/g, '')\n                .trim();\n              if (cleaned) return cleaned;\n            }\n          } else {\n            const res = await AiPhoneGame.callGlobalLLM({\n              messages: [\n                { role: 'system', content: `你是一个正在喝奶茶的朋友。${systemPrompt}` },\n                { role: 'user', content: userActionPrompt }\n              ]\n            });\n            if (res && res.content) {\n              let cleaned = res.content.trim()\n                .replace(/^[\"“]|[\"”]$/g, '')\n                .replace(/（[^）]*）|\\([^)]*\\)/g, '')\n                .trim();\n              if (cleaned) return cleaned;\n            }\n          }\n        } catch(e) {\n          console.error('LLM调用失败:', e);\n        }\n      }\n\n      if (type === 'choked') {\n        return `喝这么急做什么，又没人跟你抢，快顺顺气。`;\n      } else if (type === 'busted') {\n        return `怎么还跟个小孩子一样，想喝直接和我说就是了。`;\n      } else {\n        return `空了？……什么时候喝完的，动作倒挺快。`;\n      }\n    }\n\n    async function recordEvent(type, quote) {\n      if (!window.AiPhoneGame || !selectedCharacter || selectedCharacter.id === 'default_char') return;\n      try {\n        const charName = selectedCharacter.name;\n        let summary = '';\n        if (type === 'busted') {\n          summary = `${playerName}在玩偷喝奶茶小游戏时，偷喝${charName}的奶茶被当场发现，${charName}见状说道：“${quote}”。`;\n        } else if (type === 'win') {\n          summary = `${playerName}在玩偷喝奶茶小游戏时，成功偷喝完了${charName}的一整杯奶茶，${charName}发现奶茶见底后说道：“${quote}”。`;\n        } else if (type === 'choked') {\n          summary = `${playerName}在玩偷喝奶茶小游戏时，因为偷喝太急呛到了，${charName}看到后说道：“${quote}”。`;\n        }\n\n        await AiPhoneGame.recordGameEvent({\n          characterIds: [selectedCharacter.id],\n          summary: summary\n        });\n      } catch(e) {\n        console.error('记录事件失败:', e);\n      }\n    }\n\n    function resetGame() {\n      isGameOver = false;\n      isDrinking = false;\n      const conf = DIFF_CONFIG[currentDifficulty];\n      maxVolume = 100 * conf.capacityMultiplier;\n      currentVolume = maxVolume;\n      chokeValue = 0;\n\n      if (conf.hasChoke) {\n        chokeMeterWrap.classList.add('active');\n      } else {\n        chokeMeterWrap.classList.remove('active');\n      }\n\n      drinkHint.textContent = conf.hint;\n      updateTeaUI();\n      updateChokeUI();\n      resultModal.classList.remove('active');\n      hideBubble();\n      setState(STATES.BUSY);\n    }\n\n    function openCharSelect() {\n      if (!availableCharacters || availableCharacters.length === 0) {\n        alert('当前没有更多可用角色卡哦～');\n        return;\n      }\n      charSelectList.innerHTML = '';\n      availableCharacters.forEach(c => {\n        const item = document.createElement('div');\n        item.className = 'char-select-item';\n        item.innerHTML = `\n          <img class=\"char-select-avatar\" src=\"${c.avatar || 'data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'40\\' height=\\'40\\'><circle cx=\\'20\\' cy=\\'20\\' r=\\'20\\' fill=\\'%23fde68a\\'/></svg>'}\" />\n          <div>\n            <div style=\"font-size:13px; font-weight:700;\">${c.name}</div>\n            <div style=\"font-size:11px; color:#64748b;\">${c.subtitle || 'AI互动角色'}</div>\n          </div>\n        `;\n        item.onclick = () => {\n          setCharacter(c);\n          selectModal.classList.remove('active');\n          if (!playView.classList.contains('hidden')) {\n            resetGame();\n          }\n        };\n        charSelectList.appendChild(item);\n      });\n      selectModal.classList.add('active');\n    }\n\n    drinkBtn.addEventListener('mousedown', startDrinking);\n    window.addEventListener('mouseup', stopDrinking);\n    drinkBtn.addEventListener('touchstart', startDrinking, { passive: false });\n    window.addEventListener('touchend', stopDrinking, { passive: false });\n    window.addEventListener('touchcancel', stopDrinking, { passive: false });\n\n    btnRestart.addEventListener('click', resetGame);\n    btnSwitch.addEventListener('click', backToModeSelect);\n    diffBadgeBtn.addEventListener('click', backToModeSelect);\n    coverCharBtn.addEventListener('click', openCharSelect);\n    charBadgeBtn.addEventListener('click', openCharSelect);\n    closeSelectBtn.addEventListener('click', () => selectModal.classList.remove('active'));\n\n    window.addEventListener('DOMContentLoaded', initHost);\n  </script>\n</body>\n</html>",
    "allowExternalControl": true
  }
}
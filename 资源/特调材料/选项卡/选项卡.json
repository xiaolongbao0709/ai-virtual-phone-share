{
  "mark": "float-mixology-material",
  "version": 1,
  "material": {
    "id": "mixmat_mtklxuc2ve6qqg",
    "name": "选项卡",
    "hook": "对话底部提供三个选项，点击直接发送，应对词穷时刻。",
    "createdAt": 1788384472274,
    "updatedAt": 1788384472275,
    "kind": "mechanism",
    "script": "function onBeforeSend(ctx) {\n    return {\n        note: \"【系统指令】请在你的回复正文最末尾，提供3个供玩家选择的行动选项（1.推剧情 2.谈心 3.随意）。格式必须严格如下（包含尖括号）：\\n<opt>我们接下来去哪？</opt>\\n<opt>你刚才为什么那么说？</opt>\\n<opt>哈哈，这也太巧了吧！</opt>\"\n    };\n}\n\nfunction onAfterReply(ctx) {\n    let text = ctx.text || \"\";\n    let store = ctx.store || {};\n    let options = [];\n\n    // 1. 首选：尝试匹配 <opt>...</opt>\n    let optRegex = /<opt>([\\s\\S]*?)<\\/opt>/g;\n    let match;\n    while ((match = optRegex.exec(text)) !== null) {\n        options.push(match[1].trim());\n    }\n\n    // 2. 备选：如果没抓到，尝试匹配 [选项1] 或 选项： 等常见格式\n    if (options.length === 0) {\n        let lines = text.split('\\n');\n        for(let i=0; i<lines.length; i++) {\n            let line = lines[i].trim();\n            let m = line.match(/^(?:\\[选项\\d?\\]|【选项\\d?】|选项\\d?[:：])\\s*(.+)/);\n            if (m) options.push(m[1].trim());\n        }\n    }\n\n    // 3. 终极备选：如果还是没抓到，倒序抓末尾的 1. 2. 3.\n    if (options.length === 0) {\n        let lines = text.split('\\n');\n        let temp = [];\n        for(let i=lines.length-1; i>=0; i--) {\n            let line = lines[i].trim();\n            if(!line) continue;\n            let m = line.match(/^[123][.、:：]\\s*(.+)/);\n            if(m) {\n                temp.unshift(m[1].trim());\n            } else {\n                if(temp.length > 0) break; // 遇到非列表项就停\n            }\n        }\n        if(temp.length >= 3) {\n            options = temp.slice(-3);\n        }\n    }\n\n    // 执行清理，把正文里暴露的选项删掉\n    if (options.length > 0) {\n        store.aiOptions = options;\n        \n        // 删掉所有 <opt> 标签\n        text = text.replace(/<opt>[\\s\\S]*?<\\/opt>/g, '');\n        // 删掉 [选项] 行\n        text = text.replace(/\\[选项\\d?\\].*/g, '');\n        text = text.replace(/【选项\\d?】.*/g, '');\n        text = text.replace(/选项\\d?[:：].*/g, '');\n        // 删掉引导语\n        text = text.replace(/以下是.*?选项.*/g, '');\n        text = text.replace(/为你提供.*?选项.*/g, '');\n        \n        // 如果是数字列表，暴力截断最后出现的选项\n        let lastOpt = options[options.length - 1];\n        if (text.includes(lastOpt)) {\n            let cutIdx = text.indexOf(options[0]);\n            if (cutIdx > 0) {\n                // 往前找一下 1. 这种序号\n                let preText = text.substring(0, cutIdx);\n                preText = preText.replace(/\\n\\s*[123][.、:：]\\s*$/, '');\n                text = preText;\n            }\n        }\n        \n        text = text.trim();\n    } else {\n        store.aiOptions = [];\n    }\n\n    return { text: text, store: store };\n}",
    "layout": {
      "x": 4,
      "y": 12,
      "w": 40,
      "h": 30,
      "autoHeight": true,
      "drag": true,
      "chrome": "bar",
      "plate": true,
      "slot": "flow-bottom"
    },
    "panelHtml": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>AI智能回复选项卡</title>\n    <style>\n        body { \n            margin: 0; \n            padding: 12px; \n            font-family: sans-serif; \n            display: flex; \n            flex-direction: column; \n            gap: 8px; \n            /* 保留波点底纹 */\n            background-color: transparent;\n            background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);\n            background-size: 10px 10px;\n        }\n        \n        /* 白色长条胶囊开关 */\n        .toggle-capsule {\n            background: #ffffff;\n            color: #000000;\n            border: 2px solid #000000;\n            border-radius: 50px;\n            padding: 10px 24px;\n            font-size: 14px;\n            font-weight: bold;\n            text-align: center;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            cursor: pointer;\n            user-select: none;\n            box-shadow: 2px 2px 0px rgba(0,0,0,0.8);\n            transition: transform 0.1s, box-shadow 0.1s;\n            margin: 0 auto; \n            width: fit-content;\n        }\n        .toggle-capsule:active {\n            transform: translate(2px, 2px);\n            box-shadow: 0px 0px 0px rgba(0,0,0,0.8);\n        }\n\n        /* 白边框抽屉 */\n        .drawer {\n            display: none; \n            border: 2px solid #ffffff; \n            border-radius: 20px;\n            padding: 20px 12px; \n            background: transparent;\n            flex-direction: column;\n            margin-top: 4px;\n        }\n        .drawer.open {\n            display: flex;\n        }\n\n        /* 选项时间轴容器 */\n        .timeline-container {\n            position: relative;\n            display: flex;\n            flex-direction: column;\n            gap: 20px; \n        }\n        \n        /* 串联的半透明白竖线 */\n        .timeline-container::before {\n            content: '';\n            position: absolute;\n            left: 5px; /* 对应小圆圈的中心位置 */\n            top: 10px;\n            bottom: 10px;\n            width: 2px;\n            background: rgba(255, 255, 255, 0.7); \n            z-index: 0;\n        }\n        \n        /* 单个选项行 */\n        .option-row {\n            display: flex;\n            align-items: center;\n            gap: 16px; /* 因为圆圈变小了，稍微加大一点间距保持排版 */\n            position: relative;\n            z-index: 1;\n            cursor: pointer;\n        }\n\n        /* 极简小白圈 */\n        .circle-btn {\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background: transparent;\n            border: 2px solid #ffffff;\n            flex-shrink: 0;\n        }\n\n        /* 右侧白胶囊 */\n        .capsule-btn { \n            flex-grow: 1;\n            background: #ffffff; \n            border: 2px solid #000000; \n            color: #000000; \n            padding: 8px 16px; \n            border-radius: 24px; \n            font-size: 14px; \n            text-align: left; \n            line-height: 1.5; \n            display: flex; \n            align-items: center; \n            gap: 8px; \n            transition: all 0.1s;\n            position: relative;\n            overflow: hidden;\n            box-shadow: 2px 2px 0px rgba(0,0,0,0.8);\n        }\n        \n        /* 行按下时的动画 */\n        .option-row:active .capsule-btn { \n            transform: translate(2px, 2px);\n            box-shadow: 0px 0px 0px rgba(0,0,0,0.8);\n        }\n\n        /* 五角星装饰保留 */\n        .capsule-btn::after {\n            content: '';\n            position: absolute;\n            right: -4px;\n            bottom: -8px;\n            width: 36px;\n            height: 36px;\n            opacity: 0.05;\n            background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"black\"><path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"/></svg>');\n            background-repeat: no-repeat;\n            background-size: contain;\n            z-index: 0;\n            pointer-events: none;\n        }\n        \n        /* 粗棍子符号 */\n        .thick-stick {\n            width: 4px;\n            height: 14px;\n            background: #000000;\n            border-radius: 2px;\n            flex-shrink: 0;\n            z-index: 1;\n        }\n        \n        /* 黑底白字小标签 */\n        .tag { \n            font-size: 11px; \n            padding: 3px 8px; \n            border-radius: 50px; \n            white-space: nowrap; \n            flex-shrink: 0;\n            font-weight: bold;\n            background: #000000; \n            color: #ffffff;      \n            z-index: 1;\n        }\n        \n        /* 往上渐变的灰色荧光笔底纹 */\n        .highlight-text {\n            background-image: linear-gradient(to top, #d4d4d4 15%, transparent 60%);\n            display: inline;\n            z-index: 1; \n            word-break: break-word;\n        }\n        \n        .empty { \n            text-align: center; \n            color: rgba(255, 255, 255, 0.5);\n            font-size: 13px; \n            padding: 10px; \n        }\n    </style>\n</head>\n<body>\n    <div class=\"toggle-capsule\" onclick=\"toggleDrawer()\">AI OPTIONS</div>\n    \n    <div class=\"drawer\" id=\"drawer\">\n        <div id=\"container\">\n            <div class=\"empty\">等待 AI 生成选项...</div>\n        </div>\n    </div>\n    \n    <script>\n        var tags = ['推剧情', '谈心', '随意'];\n        var drawerOpen = false;\n\n        function toggleDrawer() {\n            var drawer = document.getElementById('drawer');\n            drawerOpen = !drawerOpen;\n            if (drawerOpen) {\n                drawer.classList.add('open');\n            } else {\n                drawer.classList.remove('open');\n            }\n            // 重要：通知宿主重新计算高度\n            setTimeout(function() {\n                if (window.mix && typeof window.mix.fit === 'function') {\n                    window.mix.fit(document.body.scrollHeight);\n                }\n            }, 50);\n        }\n        \n        function renderOptions(rawOptions) {\n            var container = document.getElementById('container');\n            var options = rawOptions;\n            \n            if (typeof options === 'string') {\n                try {\n                    options = JSON.parse(options);\n                } catch(e) {\n                    options = [];\n                }\n            }\n            \n            if (Array.isArray(options) && options.length > 0) {\n                var htmlStr = '<div class=\"timeline-container\">';\n                for(var i = 0; i < options.length; i++) {\n                    var optText = options[i];\n                    var safeText = optText.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n                    var safeJsText = optText.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\").replace(/\"/g, '&quot;').replace(/\\n/g, ' ');\n                    \n                    var tagName = tags[i % 3];\n                    \n                    htmlStr += '<div class=\"option-row\" onclick=\"window.mix.say(\\'' + safeJsText + '\\')\">';\n                    htmlStr += '  <div class=\"circle-btn\"></div>'; // 极简小圆圈，不显示数字\n                    htmlStr += '  <div class=\"capsule-btn\">';\n                    htmlStr += '    <div class=\"thick-stick\"></div>';\n                    htmlStr += '    <span class=\"tag\">' + tagName + '</span>';\n                    htmlStr += '    <span class=\"highlight-text\">' + safeText + '</span>';\n                    htmlStr += '  </div>';\n                    htmlStr += '</div>';\n                }\n                htmlStr += '</div>';\n                container.innerHTML = htmlStr;\n            } else {\n                container.innerHTML = '<div class=\"empty\">没捕捉到选项哦，发条消息试试看~</div>';\n            }\n            \n            setTimeout(function() {\n                if (window.mix && typeof window.mix.fit === 'function') {\n                    window.mix.fit(document.body.scrollHeight);\n                }\n            }, 100);\n        }\n\n        window.onMixSync = function(state, store) {\n            renderOptions(store ? store.aiOptions : []);\n        };\n\n        setTimeout(function() {\n            var s = window.MIX_STORE || {};\n            renderOptions(s.aiOptions);\n        }, 150);\n    </script>\n</body>\n</html>"
  }
}
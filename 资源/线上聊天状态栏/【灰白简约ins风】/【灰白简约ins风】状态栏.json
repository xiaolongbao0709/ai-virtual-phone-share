{
  "type": "ai-phone-status-region",
  "version": 1,
  "contract": "【规则】每轮回复正文后紧跟输出状态栏，独立成块。所有字段随对话时间线/剧情变化，时间不倒流，地点与上轮连贯，状态反映刚发生的事。一律键=值一行一个，禁止markdown/加粗/项目符号/旁白/解释/复述正文。时间=24h HH:MM；日期=月日 周几；地点=国家·城市·具体位置(如中国·上海·营房·窗边)；状态=身体感觉或正在做的事(一句话)；心情=当下情绪(一句话,可口语)；思念度=0-100整数(随亲密度浮动)；焦虑度=0-100整数(压力大升缓和降)；某字段无值则整行省略，不用占位符。【格式】用[状态栏]...[/状态栏]完整包裹全部字段，不得遗漏标签或拆分为普通消息：[状态栏]\n时间=HH:MM\n日期=月日 周几\n地点=国家·城市·具体位置\n状态=身体感觉/正在做的事\n心情=当下情绪\n思念度=整数\n焦虑度=整数\n[/状态栏]",
  "renderHtml": "<div class=\"kd-card\">\n  <svg class=\"kd-star\" id=\"kdStar\" viewBox=\"0 0 40 40\" aria-hidden=\"true\"><path d=\"M20 6l3.6 8.2 8.9.9-6.6 6 1.8 8.8L20 25.8 12.3 29.9l1.8-8.8-6.6-6 8.9-.9z\"/></svg>\n  <div class=\"kd-head\">\n    <span class=\"kd-tag\">RECORD</span>\n    <span class=\"kd-time\" id=\"kdHead\"></span>\n  </div>\n  <div class=\"kd-rows\" id=\"kdRows\"></div>\n  <div class=\"kd-bars\" id=\"kdBars\"></div>\n</div>\n\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: transparent; }\n  /* 底部留安全区：避免卡片下边框 + 硬投影被容器裁掉 */\n  body {\n    padding: 4px 2px 8px;\n    font-family: -apple-system, \"PingFang SC\", \"Noto Sans KR\", \"Microsoft YaHei\", sans-serif;\n  }\n\n  .kd-card {\n    position: relative;\n    margin: 0 4px;\n    padding: 14px 14px 14px;\n    background-color: #fffdfb;\n    background-image: radial-gradient(rgba(26,26,26,.12) 1px, transparent 1.2px);\n    background-size: 10px 10px;\n    background-position: 0 0;\n    background-position: 0 0, 4px 5px;\n    border: 1.5px solid #1a1a1a;\n    border-radius: 20px;\n    box-shadow: none;\n    color: #1a1a1a;\n  }\n\n  .kd-star {\n    position: absolute;\n    right: 11px;\n    bottom: 10px;\n    width: 24px;\n    height: 24px;\n    fill: #1a1a1a;\n    opacity: .14;\n    transform: rotate(14deg);\n    pointer-events: none;\n    transition: opacity .4s ease;\n  }\n\n  .kd-head {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding-bottom: 8px;\n    margin-bottom: 10px;\n    border-bottom: 2px solid #1a1a1a;\n  }\n  .kd-tag {\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .18em;\n    background: #1a1a1a;\n    color: #fffdf8;\n    padding: 2px 7px;\n    border-radius: 999px;\n  }\n  .kd-time {\n    margin-left: auto;\n    font-size: 11px;\n    color: #6b6660;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: .02em;\n  }\n\n  .kd-row {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    padding: 3.5px 0;\n    font-size: 13px;\n    line-height: 1.5;\n  }\n  .kd-k {\n    flex: 0 0 58px;\n    font-size: 10.5px;\n    font-weight: 700;\n    text-align: center;\n    letter-spacing: .04em;\n    color: #1a1a1a;\n    background: rgba(26,26,26,.055);\n    border: 1px solid rgba(26,26,26,.32);\n    border-radius: 6px;\n    padding: 2px 0;\n  }\n  .kd-v {\n    flex: 1;\n    color: #3a3833;\n    word-break: break-word;\n  }\n\n  .kd-empty {\n    padding: 6px 0 2px;\n    font-size: 11.5px;\n    color: #9a958d;\n    text-align: center;\n    letter-spacing: .08em;\n  }\n\n  .kd-bars {\n    margin-top: 9px;\n    padding-top: 9px;\n    border-top: 1px solid rgba(26,26,26,.32);\n  }\n  .kd-bar-row + .kd-bar-row { margin-top: 8px; }\n  .kd-bar-top {\n    display: flex;\n    justify-content: space-between;\n    font-size: 10.5px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    color: #1a1a1a;\n  }\n  .kd-track {\n    margin-top: 5px;\n    height: 11px;\n    padding: 1px;\n    border: 1px solid #1a1a1a;\n    border-radius: 999px;\n    background: #fffdf8;\n    overflow: hidden;\n  }\n  .kd-fill {\n    height: 100%;\n    width: 0%;\n    border-radius: 999px;\n    transition: width .45s ease;\n  }\n  /* ① 思念度：实心墨 */\n  .kd-fill-solid { background: #1a1a1a; }\n  /* ② 焦虑度：铅笔排线 */\n  .kd-fill-hatch {\n    background-color: #fffdf8;\n    background-image: repeating-linear-gradient(45deg,\n      #1a1a1a 0, #1a1a1a 3px, transparent 3px, transparent 6px);\n  }\n\n</style>\n\n<script>\n(function () {\n  var raw = (window.STATUS_RAW || '').replace(/\\[\\s*\\/?\\s*状态栏\\s*\\]/g, '');\n  var data = {}, order = [];\n\n  raw.split(/\\r?\\n/).forEach(function (line) {\n    var m = line.match(/^\\s*([^=:：]+?)\\s*[=:：]\\s*(.+?)\\s*$/);\n    if (!m) return;\n    var k = m[1].trim(), v = m[2].trim();\n    if (k && v && !(k in data)) { data[k] = v; order.push(k); }\n  });\n\n  var BARS = [\n    { key: '思念度',   cls: 'kd-fill-solid' },\n    { key: '焦虑度', cls: 'kd-fill-solid' },\n  ];\n  var SPECIAL = { '时间': 1, '日期': 1 };\n  BARS.forEach(function (b) { SPECIAL[b.key] = 1; });\n\n  var KNOWN = ['时间', '日期', '地点', '状态', '心情', '思念度', '焦虑度'];\n\n  var headEl = document.getElementById('kdHead');\n  var rowsEl = document.getElementById('kdRows');\n  var barsEl = document.getElementById('kdBars');\n  var starEl = document.getElementById('kdStar');\n\n  var stamp = [];\n  if (data['日期']) stamp.push(data['日期']);\n  if (data['时间']) stamp.push(data['时间']);\n  headEl.textContent = stamp.join('  ·  ');\n\n  var keys = KNOWN.filter(function (k) { return !SPECIAL[k] && data[k]; })\n      .concat(order.filter(function (k) { return KNOWN.indexOf(k) < 0 && !SPECIAL[k]; }));\n\n  keys.forEach(function (k) {\n    var row = document.createElement('div'); row.className = 'kd-row';\n    var kk = document.createElement('span'); kk.className = 'kd-k'; kk.textContent = k;\n    var vv = document.createElement('span'); vv.className = 'kd-v';\n    vv.textContent = data[k].replace(/\\s*\\|\\s*/g, '  ·  ');\n    row.appendChild(kk); row.appendChild(vv);\n    rowsEl.appendChild(row);\n  });\n\n  if (!keys.length) {\n    var empty = document.createElement('div');\n    empty.className = 'kd-empty';\n    empty.textContent = '';\n    rowsEl.appendChild(empty);\n  }\n\n  var shown = 0;\n  BARS.forEach(function (b) {\n    var n = parseInt(data[b.key], 10);\n    if (isNaN(n)) return;\n    n = Math.max(0, Math.min(100, n));\n    shown++;\n    var wrap = document.createElement('div'); wrap.className = 'kd-bar-row';\n    var top = document.createElement('div'); top.className = 'kd-bar-top';\n    var name = document.createElement('span'); name.textContent = b.key;\n    var num = document.createElement('span'); num.textContent = n;\n    top.appendChild(name); top.appendChild(num);\n    var track = document.createElement('div'); track.className = 'kd-track';\n    var fill = document.createElement('div'); fill.className = 'kd-fill ' + b.cls;\n    track.appendChild(fill);\n    wrap.appendChild(top); wrap.appendChild(track);\n    barsEl.appendChild(wrap);\n    setTimeout(function () { fill.style.width = n + '%'; }, 30);\n  });\n\n  if (!shown) barsEl.style.display = 'none';\n\n})();\n</script>",
  "previewRaw": "[状态栏]\n时间=23:47\n日期=3月14日 周六\n地点=中国·上海·营房·窗边\n状态=刚洗漱完，头发还湿着\n心情=平静，有点想你\n思念度=78\n焦虑度=24\n[/状态栏]"
}
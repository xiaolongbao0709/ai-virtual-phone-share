 </div>\n    </div>\n\n    <div class=\"panel\" id=\"panel4\">\n      <div class=\"weather-single-box\">\n        <div class=\"weather-title\" id=\"v_lyricLine\"></div>\n        <div class=\"song-source\" id=\"v_dedicationSong\"></div>\n        <div class=\"tip-line\" id=\"v_djReflection\"></div>\n        <div class=\"goodnight-txt\" id=\"v_closingMsg\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nvar raw = window.STATUS_RAW || '';\nvar data = {};\nraw = raw.replace(/^\\[状态栏\\]/,'').replace(/\\[\\/状态栏\\]$/,'').trim();\nvar lines = raw.split('\\n');\nlines.forEach(function(line){\n  line = line.trim();\n  if(!line) return;\n  var eqPos = line.indexOf('=');\n  if(eqPos <= 0) return;\n  var k = line.substring(0, eqPos).trim();\n  var v = line.substring(eqPos + 1).trim();\n  data[k] = v;\n});\n\nfunction set(id,val){\n  var el = document.getElementById(id);\n  if(el) {\n    var cleanVal = (val == null ? '' : String(val)).replace(/<[^>]+>/g, '');\n    el.textContent = cleanVal;\n  }\n}\n\nfunction songTitle(v){\n  if(!v) return '';\n  return '《' + String(v).replace(/^《/,'').replace(/》$/,'').trim() + '》';\n}\n\nset('v_djname', data.dj_name);\nset('v_freq', data.radio_freq);\nset('v_program', data.program_title);\nset('v_onairtime', data.onair_time);\nset('v_marquee', data.marquee_text);\nset('v_onairScript', data.onair_script);\nset('v_letterAudience', data.letter_from_audience);\nset('v_broadReply', data.broad_reply);\nset('v_barrage1', data.barrage1);\nset('v_btime1', data.barrage_time1);\nset('v_uid1', data.barrage_uid1);\nset('v_barrage2', data.barrage2);\nset('v_btime2', data.barrage_time2);\nset('v_uid2', data.barrage_uid2);\nset('v_barrage3', data.barrage3);\nset('v_btime3', data.barrage_time3);\nset('v_uid3', data.barrage_uid3);\nset('v_s1title', songTitle(data.song1_title));\nset('v_s1singer', data.song1_singer);\nset('v_s1msg', data.song1_msg);\nset('v_s1likes', data.song1_likes);\nset('v_s2title', songTitle(data.song2_title));\nset('v_s2singer', data.song2_singer);\nset('v_s2msg', data.song2_msg);\nset('v_s2likes', data.song2_likes);\nset('v_s3title', songTitle(data.song3_title));\nset('v_s3singer', data.song3_singer);\nset('v_s3msg', data.song3_msg);\nset('v_s3likes', data.song3_likes);\nset('v_draftScrapped', data.draft_scrapped);\nset('v_djNote', data.dj_note);\nset('v_midnightSoliloquy', data.midnight_soliloquy);\nset('v_wish1', data.wish_memo1);\nset('v_wish2', data.wish_memo2);\nset('v_wish3', data.wish_memo3);\nset('v_lyricLine', data.lyric_line);\nset('v_dedicationSong', data.dedication_song);\nset('v_djReflection', data.dj_reflection);\nset('v_closingMsg', data.closing_msg);\n\n\nvar btns = document.querySelectorAll('.tab-btn');\nvar panels = document.querySelectorAll('.panel');\nbtns.forEach(function(b){b.classList.remove('active');});\npanels.forEach(function(p){p.classList.remove('active');});\nif(btns[0]) btns[0].classList.add('active');\nif(document.getElementById('panel0')) document.getElementById('panel0').classList.add('active');\nbtns.forEach(function(btn){\n  btn.onclick = function(){\n    var tid = this.dataset.tab;\n    btns.forEach(function(b){b.classList.remove('active');});\n    panels.forEach(function(p){p.classList.remove('active');});\n    this.classList.add('active');\n    document.getElementById('panel' + tid).classList.add('active');\n  };\n});\n\n// 弹幕浮现动画\nvar barrageIndex = 0;\nvar barrageItems = [\n  document.getElementById('barrageItem1'),\n  document.getElementById('barrageItem2'),\n  document.getElementById('barrageItem3')\n];\nfunction showBarrage(i){\n  barrageItems.forEach(function(el){el.classList.remove('barrage-active');});\n  barrageItems[i].classList.add('barrage-active');\n}\nif(barrageItems.length === 3){\n  showBarrage(0);\n  setInterval(function(){\n    barrageIndex = (barrageIndex + 1) % 3;\n    showBarrage(barrageIndex);\n  }, 2600);\n}\n\n// 备忘录三条轮播浮现\nvar wishIndex = 0;\nvar wishItems = [\n  document.getElementById('v_wish1'),\n  document.getElementById('v_wish2'),\n  document.getElementById('v_wish3')\n];\nfunction showWish(i){\n  wishItems.forEach(function(el){el.classList.remove('wish-active');});\n  wishItems[i].classList.add('wish-active');\n}\nif(wishItems.length === 3){\n  showWish(0);\n  setInterval(function(){\n    wishIndex = (wishIndex + 1) % 3;\n    showWish(wishIndex);\n  }, 2400);\n}\n// 歌单：触摸按下反馈 + 点击切换播放\ndocument.querySelectorAll('.song-item').forEach(function(item){\n  item.addEventListener('touchstart', function(){item.classList.add('pressed');},{passive:true});\n  item.addEventListener('touchend', function(){item.classList.remove('pressed');});\n  item.addEventListener('touchcancel', function(){item.classList.remove('pressed');});\n  item.addEventListener('mousedown', function(){item.classList.add('pressed');});\n  item.addEventListener('mouseup', function(){item.classList.remove('pressed');});\n  item.addEventListener('mouseleave', function(){item.classList.remove('pressed');});\n  item.addEventListener('click', function(){\n    document.querySelectorAll('.song-item').forEach(function(s){s.classList.remove('playing');});\n    item.classList.add('playing');\n  });\n});\n</script>",
  "previewRaw": "[状态栏]\ndj_name=晚叙\nradio_freq=FM.07.14\nprogram_title=午夜隔窗私语\nonair_time=01:27\nonair_script=夜色慢慢落下来的时候，很多藏在心底的话才敢浮上来。今夜我们不聊沉重的话题，只听晚风，听那些难以直白诉说的心意，愿电波可以抵达你的身边。\nmarquee_text=午夜FM｜所有无法当面说出口，都交给深夜的无线电波\nletter_from_audience=有时候会很好奇DJ藏在麦克风背后是什么样子，很多情绪是不是也只能借着广播才能讲出来。\nbroad_reply=我想很多人都是如此，现实里难以开口，就寄希望于看不见的电波，希望这份声音可以带给你一点安抚。\nbarrage1=深夜听这个节目好治愈\nbarrage_uid1=Night0714\nbarrage_time1=01:14\nbarrage2=会不会DJ也有不敢说的心事\nbarrage_uid2=SilentWind\nbarrage_time2=01:19\nbarrage3=希望今夜所有人都安稳好梦\nbarrage_uid3=DarkEcho\nbarrage_time3=01:25\nsong1_title=这世界那么多人\nsong1_singer=莫文蔚\nsong1_msg=送给那个隔着电波的人，愿晚风替我问候你。\nsong1_likes=231\nsong2_title=慢冷\nsong2_singer=梁静茹\nsong2_msg=有些话适合封存，不必一定要得到回应。\nsong2_likes=156\nsong3_title=追光者\nsong3_singer=岑宁儿\nsong3_msg=点播给深夜未眠，心里装着人的听众。\nsong3_likes=189\ndraft_scrapped=其实我渴望站到你的身旁，可又怕打扰你的生活，只能把心意全部藏起来。\ndj_note=麦克风一关，才敢面对自己真实想法。\nmidnight_soliloquy=当直播间归于寂静，才敢袒露私心。广播可以伪装温柔，但心跳不会骗人，有些心事永远不能播出。\nwish_memo1=想跨过电波去见你\nwish_memo2=害怕我的心意造成负担\nwish_memo3=希望可以再多靠近一点\nlyric_line=「所有的安静都是与人无关的想念」\ndedication_song=《这世界那么多人》莫文蔚\ndj_reflection=这首歌是电影《我要我们在一起》的主题曲，写的是那些错过的人。莫文蔚用她那种不太用力的嗓音唱出来，反而更戳人。导演说这首歌是写给每一个在深夜想起旧人的听众，不管那个人现在在谁身边，今晚把它送给你。\nclosing_msg=今夜的节目到此结束，愿电波伴你入眠，我们下一个午夜再会。\n[/状态栏]"
}
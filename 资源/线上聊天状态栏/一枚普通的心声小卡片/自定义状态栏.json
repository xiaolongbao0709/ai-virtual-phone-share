{
  "type": "ai-phone-status-region",
  "version": 1,
  "contract": "【逻辑】维护角色内心状态面板。每行一个字段，用=分隔，除格式列出的字段外不要输出其他内容。按生成的内容整块用 [状态栏]...[/状态栏] 包裹输出。\n【格式】\n[状态栏]\n好感度=\n占有欲=\n焦虑值=\n心情=代表心情的颜文字+20字以上描述\n内心想法=角色真实内心，50字以上\n阴暗面=深层想法，要直白，可以有阴暗 过激 色情内容，80字以上，要写出角色最深层的欲望和意淫\n没说出口的话=输入框删掉没发送的话，10字以上\n想做的事=下一步行动，30字以上\n[/状态栏]",
  "renderHtml": "<style>\n:root{\n  --bg:#ffffff;\n  --text:#2c3440;\n  --sub:#797e85;\n  --line:#e2e2e2;\n  --danger:#d9788d;\n  --bar-good:#5789d8;\n  --bar-possess:#d6728c;\n  --bar-anxiety:#e49b48;\n}\nbody{\n  margin:0;\n  padding:4px;\n  background:transparent;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n}\n.card-wrap{\n  width:100%;\n  max-width:400px;\n  background:#fff8dd;\n  border-radius:16px;\n  position:relative;\n  padding:22px 20px;\n  box-sizing:border-box;\n  box-shadow:0 6px 22px rgba(0,0,0,0.12);\n  overflow:hidden;\n}\n.card-wrap::before{\n  content:\"\";\n  position:absolute;\n  top:0;left:12px;\n  width:52px;height:14px;\n  background:#ffb8bc;\n  transform:rotate(-8deg);opacity:0.75;\n}\n.card-wrap::after{\n  content:\"\";\n  position:absolute;\n  top:0;right:12px;\n  width:52px;height:14px;\n  background:#b8e1e4;\n  transform:rotate(8deg);opacity:0.75;\n}\n.card-title{\n  display:flex;align-items:center;gap:6px;\n  font-size:15px;font-weight:bold;color:#b48c4c;\n  margin-bottom:16px;margin-top:4px;\n}\n.bar-row{\n  display:flex;align-items:center;gap:10px;margin-bottom:8px;\n}\n.bar-label{\n  width:62px;flex-shrink:0;font-size:13px;color:#634f36;\n}\n.bar-track{\n  flex:1;height:10px;background:#e9e2cd;border-radius:999px;overflow:hidden;\n}\n.bar-fill{\n  height:100%;\n  border-radius:999px;\n  transition: width 0.4s ease; /* 数值变化平滑动画 */\n}\n.bar-num{\n  width:32px;text-align:right;font-size:13px;font-weight:600;color:#634f36;\n}\n.divider{height:1px;background:#e2d9c2;margin:14px 0;}\n.field-item{margin-bottom:10px;}\n.field‑label{font-size:12px;color:#a07e54;margin-bottom:3px;}\n.field‑text{font-size:14px;line-height:1.65;color:#4b3c2a;word-break:break-word;}\n.danger-field{\n  background:rgba(217,120,141,0.07);\n  border-left:3px solid var(--danger);\n  padding:7px 10px;border-radius:6px;\n}\n</style>\n<div id=\"app\"></div>\n<script>\nfunction el(tag,cls,txt){\n  const e=document.createElement(tag);\n  if(cls)e.className=cls;\n  if(txt!==undefined)e.textContent=txt;\n  return e;\n}\nfunction escapeHtml(str){\n  if(!str)return\"\";\n  return String(str).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");\n}\n\n// 数值安全处理：转数字，强制限制0‑100，非法返回0\nfunction safePercent(rawVal){\n  let num = Number(rawVal);\n  if(isNaN(num)) num = 0;\n  return Math.max(0, Math.min(100, num));\n}\n\nconst data={};\nconst rawText = (window.STATUS_RAW || \"\");\nif(rawText){\n  rawText.split(/\\r?\\n/).forEach(line=>{\n    const t=line.trim();\n    if(!t)return;\n    const eqIdx = t.indexOf(\"=\");\n    if(eqIdx>0){\n      const k = t.slice(0,eqIdx).trim();\n      const v = t.slice(eqIdx+1).trim();\n      data[k]=v;\n    }\n  })\n}\n\nconst app = document.getElementById(\"app\");\nconst card = el(\"div\",\"card-wrap\");\n\n//标题\nconst titleDiv = el(\"div\",\"card-title\",\"💭 内心独白\");\ncard.appendChild(titleDiv);\n\n//三条进度条\nconst barWrap = el(\"div\");\n\n//好感度\nconst valGood = safePercent(data[\"好感度\"]);\nconst b1 = el(\"div\",\"bar-row\");\nb1.appendChild(el(\"div\",\"bar-label\",\"好感度\"));\nconst tr1 = el(\"div\",\"bar-track\");\nconst f1 = el(\"div\",\"bar-fill\");\nf1.style.width = valGood + \"%\";\nf1.style.background = \"var(--bar-good)\";\ntr1.appendChild(f1);\nb1.appendChild(tr1);\nb1.appendChild(el(\"div\",\"bar-num\",valGood));\nbarWrap.appendChild(b1);\n\n//占有欲\nconst valPos = safePercent(data[\"占有欲\"]);\nconst b2 = el(\"div\",\"bar-row\");\nb2.appendChild(el(\"div\",\"bar-label\",\"占有欲\"));\nconst tr2 = el(\"div\",\"bar-track\");\nconst f2 = el(\"div\",\"bar-fill\");\nf2.style.width = valPos + \"%\";\nf2.style.background = \"var(--bar-possess)\";\ntr2.appendChild(f2);\nb2.appendChild(tr2);\nb2.appendChild(el(\"div\",\"bar-num\",valPos));\nbarWrap.appendChild(b2);\n\n//焦虑值\nconst valAnx = safePercent(data[\"焦虑值\"]);\nconst b3 = el(\"div\",\"bar-row\");\nb3.appendChild(el(\"div\",\"bar-label\",\"焦虑值\"));\nconst tr3 = el(\"div\",\"bar-track\");\nconst f3 = el(\"div\",\"bar-fill\");\nf3.style.width = valAnx + \"%\";\nf3.style.background = \"var(--bar-anxiety)\";\ntr3.appendChild(f3);\nb3.appendChild(tr3);\nb3.appendChild(el(\"div\",\"bar-num\",valAnx));\nbarWrap.appendChild(b3);\n\ncard.appendChild(barWrap);\ncard.appendChild(el(\"div\",\"divider\"));\n\n//渲染各个文本字段\nfunction addField(labelText,content,isDanger){\n  const wrap = el(\"div\",\"field-item\"+(isDanger?\" danger-field\":\"\"));\n  wrap.appendChild(el(\"div\",\"field‑label\",labelText));\n  const txtDiv = el(\"div\",\"field‑text\");\n  txtDiv.innerHTML = escapeHtml(content||\"\");\n  wrap.appendChild(txtDiv);\n  card.appendChild(wrap);\n}\n\naddField(\"心情\",data[\"心情\"]);\naddField(\"内心想法\",data[\"内心想法\"]);\naddField(\"阴暗面\",data[\"阴暗面\"],true);\naddField(\"没说出口的话\",data[\"没说出口的话\"]);\naddField(\"想做的事\",data[\"想做的事\"]);\n\napp.appendChild(card);\n</script>",
  "previewRaw": "[状态栏]\n好感度=20\n占有欲=77\n焦虑值=90\n心情=😔隐忍克制，心里乱糟糟\n内心想法=一边在意对方，又害怕自己的情绪会吓到人\n阴暗面=想把对方牢牢攥在自己视线里，不希望别人靠近\n没说出口的话=其实我很怕你会慢慢疏远我\n想做的事=继续观察对方的态度，试探边界\n[/状态栏]"
}
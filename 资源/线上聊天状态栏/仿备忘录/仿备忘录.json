{
  "type": "ai-phone-status-region",
  "version": 1,
  "contract": "【逻辑】维护角色内心状态面板。每行一个字段，用=分隔，除格式列出的字段外不要输出其他内容。按生成的内容整块用 [状态栏]...[/状态栏] 包裹输出。\n【格式】\n[状态栏]\n好感度=\n占有欲=\n焦虑值=\n心情=代表心情的颜文字+20字以上描述\n内心想法=角色真实内心，50字以上\n阴暗面=深层想法，要直白，可以有阴暗、过激、色情内容，80字以上，要写出角色最深层的欲望和意淫\n没说出口的话=输入框删掉没发送的话，10字以上\n想做的事=下一步想做的事情，30字以上，可以分条目\n[/状态栏]",
  "renderHtml": "<style>\n:root{\n  --ink:#000;\n  --muted:#8e8e93;\n  --line:#e5e5ea;\n  --line2:#f2f2f7;\n  --yellow:#ffcc00;\n  --blue:#007aff;\n  --pink:#ff2d55;\n  --orange:#ff9500;\n}\n*{box-sizing:border-box;}\nhtml,body{margin:0;padding:0;background:transparent;}\nbody{\n  display:flex;\n  justify-content:center;\n  padding:8px;\n  font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"PingFang SC\",\"Helvetica Neue\",sans-serif;\n  -webkit-font-smoothing:antialiased;\n}\nbutton{font-family:inherit;appearance:none;-webkit-appearance:none;}\n\n.app{\n  width:100%;\n  max-width:400px;\n  background:#ffffff;\n  border-radius:12px;\n  overflow:hidden;\n  box-shadow:0 1px 3px rgba(0,0,0,.07), 0 12px 32px rgba(0,0,0,.10);\n}\n\n/* ── 导航栏 ── */\n.nav{\n  height:48px;\n  display:flex;\n  align-items:center;\n  padding:0 6px;\n  background:#fff;\n  border-bottom:0.5px solid var(--line);\n}\n.nav-btn{\n  display:flex;\n  align-items:center;\n  gap:3px;\n  color:var(--yellow);\n  background:transparent;\n  border:0;\n  padding:6px 8px;\n  font-size:17px;\n  line-height:1;\n  cursor:pointer;\n}\n.nav-btn svg{display:block;}\n.nav-back .chev{margin-top:-1px;}\n.nav-right{margin-left:auto;display:flex;align-items:center;}\n\n/* ── 正文 ── */\n.body{padding:16px 20px 20px;}\n\n.note-title{\n  font-size:28px;\n  font-weight:700;\n  letter-spacing:-.5px;\n  line-height:1.2;\n  color:var(--ink);\n  margin:4px 0 4px;\n}\n.note-date{\n  font-size:13px;\n  color:var(--muted);\n  margin-bottom:16px;\n  display:flex;\n  align-items:center;\n  gap:6px;\n}\n.note-date .dot{color:#c7c7cc;}\n\n/* ── 进度条组 ── */\n.stats{\n  padding:6px 0 16px;\n  border-bottom:0.5px solid var(--line2);\n}\n.stat-row{\n  display:flex;\n  align-items:center;\n  gap:12px;\n  padding:7px 0;\n}\n.stat-label{\n  width:56px;\n  flex-shrink:0;\n  font-size:14px;\n  color:var(--ink);\n}\n.stat-track{\n  flex:1;\n  height:5px;\n  background:#e8e8ed;\n  border-radius:3px;\n  overflow:hidden;\n}\n.stat-fill{\n  height:100%;\n  border-radius:3px;\n  transition:width .45s cubic-bezier(.4,0,.2,1);\n}\n.stat-num{\n  width:32px;\n  text-align:right;\n  font-size:13px;\n  font-weight:500;\n  color:var(--muted);\n  font-variant-numeric:tabular-nums;\n}\n\n/* ── 字段 ── */\n.field{padding:14px 0;}\n.field + .field{border-top:0.5px solid var(--line2);}\n\n.field-label-row{\n  display:flex;\n  align-items:center;\n  gap:6px;\n  margin-bottom:5px;\n}\n.field-label{\n  font-size:12px;\n  font-weight:600;\n  color:var(--muted);\n  letter-spacing:.02em;\n}\n.field-meta{\n  margin-left:auto;\n  font-size:11px;\n  color:#b0b0b5;\n  font-variant-numeric:tabular-nums;\n}\n\n.field-text{\n  font-size:16px;\n  line-height:1.55;\n  color:var(--ink);\n  word-break:break-word;\n  white-space:pre-wrap;\n}\n\n/* ① 心情：蓝色下划线 */\n.field.underline .field-text{\n  text-decoration: underline;\n  text-decoration-color: rgba(0,122,255,.45);\n  text-decoration-thickness: 1.5px;\n  text-underline-offset: 3px;\n}\n\n/* ② 内心想法：左上角引号装饰 */\n.field.thought .field-text{\n  position:relative;\n  padding-top:2px;\n}\n.field.thought .field-text::before{\n  content:\"\\201C\";\n  position:absolute;\n  top:-13px;\n  left:-2px;\n  font-size:38px;\n  line-height:1;\n  font-family:Georgia,\"Times New Roman\",serif;\n  color:rgba(255,204,0,.55);\n  pointer-events:none;\n}\n\n/* ③ 阴暗面：黄色荧光笔 + 竖条 */\n.field.danger{\n  position:relative;\n  padding-left:12px;\n}\n.field.danger::before{\n  content:\"\";\n  position:absolute;\n  left:0;\n  top:16px;\n  bottom:16px;\n  width:3px;\n  border-radius:2px;\n  background:var(--yellow);\n}\n.field.danger .field-label{color:#b58900;}\n.field.danger .field-text{\n  background:rgba(255,204,0,.20);\n  border-radius:3px;\n  padding:1px 5px;\n  margin-left:-5px;\n  -webkit-box-decoration-break:clone;\n  box-decoration-break:clone;\n}\n\n/* ④ 没说出口的话：灰色引用块 */\n.field.quote .field-text{\n  border-left:2px solid #c7c7cc;\n  padding-left:11px;\n  color:#636366;\n  font-style:italic;\n}\n\n/* ⑤ 想做的事：圆形待办清单 */\n.checklist-wrap{display:flex;flex-direction:column;gap:7px;}\n.checklist-item{display:flex;align-items:flex-start;gap:10px;}\n.checklist-item::before{\n  content:\"\";\n  flex-shrink:0;\n  width:14px;height:14px;\n  margin-top:4px;\n  border:1.5px solid #c7c7cc;\n  border-radius:50%;\n}\n.checklist-text{\n  font-size:16px;\n  line-height:1.55;\n  color:var(--ink);\n  word-break:break-word;\n}\n.checklist-item.done::before{\n  background:var(--yellow);\n  border-color:var(--yellow);\n  background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23fff' stroke-width='3.2' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>\");\n  background-size:10px 10px;\n  background-position:center;\n  background-repeat:no-repeat;\n}\n.checklist-item.done .checklist-text{\n  text-decoration:line-through;\n  color:#8e8e93;\n}\n\n/* ── 底部元数据 ── */\n.footer{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  margin-top:20px;\n  padding-top:14px;\n  border-top:0.5px solid var(--line2);\n  font-size:11px;\n  color:#b0b0b5;\n}\n.footer span{display:flex;align-items:center;gap:4px;}\n.footer svg{opacity:.5;}\n</style>\n\n<div id=\"app\"></div>\n<script>\nfunction el(tag, cls, txt){\n  const e = document.createElement(tag);\n  if(cls) e.className = cls;\n  if(txt !== undefined) e.textContent = txt;\n  return e;\n}\n\nfunction safePercent(rawVal){\n  let num = Number(rawVal);\n  if(isNaN(num)) num = 0;\n  return Math.max(0, Math.min(100, num));\n}\n\nconst data = {};\nconst rawText = (window.STATUS_RAW || \"\");\nif(rawText){\n  rawText.split(/\\r?\\n/).forEach(line=>{\n    const t = line.trim();\n    if(!t) return;\n    const eqIdx = t.indexOf(\"=\");\n    if(eqIdx > 0){\n      const k = t.slice(0, eqIdx).trim();\n      const v = t.slice(eqIdx + 1).trim();\n      data[k] = v;\n    }\n  });\n}\n\nconst now = new Date();\nconst timeStr = String(now.getHours()).padStart(2,\"0\") + \":\" + String(now.getMinutes()).padStart(2,\"0\");\n\nconst app = document.getElementById(\"app\");\nconst root = el(\"div\", \"app\");\n\n/* ── 导航栏 ── */\nconst nav = el(\"div\", \"nav\");\n\nconst back = el(\"button\", \"nav-btn nav-back\");\nback.innerHTML = `\n  <svg class=\"chev\" width=\"12\" height=\"20\" viewBox=\"0 0 12 20\" fill=\"none\"\n       stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M10 2L2 10l8 8\"/>\n  </svg>\n  <span>备忘录</span>\n`;\nnav.appendChild(back);\n\nconst right = el(\"div\", \"nav-right\");\n\n// 锁定图标\nconst lockBtn = el(\"button\", \"nav-btn\");\nlockBtn.innerHTML = `\n  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"\n       stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/>\n    <path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/>\n  </svg>\n`;\nright.appendChild(lockBtn);\n\n// 分享\nconst shareBtn = el(\"button\", \"nav-btn\");\nshareBtn.innerHTML = `\n  <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\"\n       stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M12 16V4\"/>\n    <path d=\"M8 8l4-4 4 4\"/>\n    <path d=\"M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6\"/>\n  </svg>\n`;\nright.appendChild(shareBtn);\n\n// 更多\nconst moreBtn = el(\"button\", \"nav-btn\");\nmoreBtn.innerHTML = `\n  <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n    <circle cx=\"5\" cy=\"12\" r=\"1.9\"/>\n    <circle cx=\"12\" cy=\"12\" r=\"1.9\"/>\n    <circle cx=\"19\" cy=\"12\" r=\"1.9\"/>\n  </svg>\n`;\nright.appendChild(moreBtn);\n\nnav.appendChild(right);\nroot.appendChild(nav);\n\n/* ── 正文 ── */\nconst body = el(\"div\", \"body\");\nbody.appendChild(el(\"div\", \"note-title\", \"内心独白\"));\n\n// 日期 + 字数\nconst allText = [\"心情\",\"内心想法\",\"阴暗面\",\"没说出口的话\",\"想做的事\"]\n  .map(k => data[k] || \"\")\n  .join(\"\")\n  .replace(/\\s/g, \"\");\nconst wordCount = Array.from(allText).length;\n\nconst week = [\"周日\",\"周一\",\"周二\",\"周三\",\"周四\",\"周五\",\"周六\"][now.getDay()];\nconst dateStr = now.getFullYear() + \"年\" + (now.getMonth()+1) + \"月\" + now.getDate() + \"日 \" + week;\n\nconst dateLine = el(\"div\", \"note-date\");\ndateLine.appendChild(el(\"span\", null, dateStr));\ndateLine.appendChild(el(\"span\", \"dot\", \"·\"));\ndateLine.appendChild(el(\"span\", null, wordCount + \" 字\"));\nbody.appendChild(dateLine);\n\n/* 进度条组 */\nconst stats = el(\"div\", \"stats\");\nfunction addStat(label, val, color){\n  const row = el(\"div\", \"stat-row\");\n  row.appendChild(el(\"div\", \"stat-label\", label));\n  const track = el(\"div\", \"stat-track\");\n  const fill = el(\"div\", \"stat-fill\");\n  fill.style.width = val + \"%\";\n  fill.style.background = color;\n  track.appendChild(fill);\n  row.appendChild(track);\n  row.appendChild(el(\"div\", \"stat-num\", String(val)));\n  stats.appendChild(row);\n}\naddStat(\"好感度\", safePercent(data[\"好感度\"]), \"var(--blue)\");\naddStat(\"占有欲\", safePercent(data[\"占有欲\"]), \"var(--pink)\");\naddStat(\"焦虑值\", safePercent(data[\"焦虑值\"]), \"var(--orange)\");\nbody.appendChild(stats);\n\n/* 字段构造 */\nfunction addField(labelText, content, opts){\n  opts = opts || {};\n  const row = el(\"div\", \"field\" + (opts.type ? \" \" + opts.type : \"\"));\n  const labelRow = el(\"div\", \"field-label-row\");\n  labelRow.appendChild(el(\"span\", \"field-label\", labelText));\n\n  if(opts.meta){\n    labelRow.appendChild(el(\"span\", \"field-meta\", opts.meta));\n  }\n\n  row.appendChild(labelRow);\n  row.appendChild(el(\"div\", \"field-text\", content || \"\"));\n  body.appendChild(row);\n}\n\n/* 清单构造 */\nfunction addChecklist(labelText, content){\n  const lines = (content || \"\").split(/\\r?\\n/).map(s => s.trim()).filter(Boolean);\n  const doneCount = Math.min(2, Math.floor(lines.length / 2));\n\n  const row = el(\"div\", \"field\");\n  const labelRow = el(\"div\", \"field-label-row\");\n  labelRow.appendChild(el(\"span\", \"field-label\", labelText));\n  if(lines.length > 0){\n    labelRow.appendChild(el(\"span\", \"field-meta\", doneCount + \"/\" + lines.length));\n  }\n  row.appendChild(labelRow);\n\n  if(lines.length <= 1){\n    row.appendChild(el(\"div\", \"field-text\", lines[0] || \"\"));\n  } else {\n    const wrap = el(\"div\", \"checklist-wrap\");\n    lines.forEach((line, i) => {\n      const item = el(\"div\", \"checklist-item\" + (i < doneCount ? \" done\" : \"\"));\n      item.appendChild(el(\"div\", \"checklist-text\", line));\n      wrap.appendChild(item);\n    });\n    row.appendChild(wrap);\n  }\n  body.appendChild(row);\n}\n\naddField(\"心情\", data[\"心情\"], { type:\"underline\", meta:\"刚刚\" });\naddField(\"内心想法\", data[\"内心想法\"], { type:\"thought\" });\naddField(\"阴暗面\", data[\"阴暗面\"], { type:\"danger\" });\naddField(\"没说出口的话\", data[\"没说出口的话\"], { type:\"quote\", meta:\"未发送\" });\naddChecklist(\"想做的事\", data[\"想做的事\"]);\n\n/* 底部元数据 */\nconst footer = el(\"div\", \"footer\");\nconst left = el(\"span\");\nleft.innerHTML = `\n  <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\"\n       stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/>\n    <path d=\"M14 2v6h6\"/>\n  </svg>\n  ${wordCount} 字\n`;\nconst rightSpan = el(\"span\", null, \"最后编辑 \" + timeStr);\nfooter.appendChild(left);\nfooter.appendChild(rightSpan);\nbody.appendChild(footer);\n\nroot.appendChild(body);\napp.appendChild(root);\n</script>",
  "previewRaw": "[状态栏]\n好感度=20\n占有欲=77\n焦虑值=90\n心情=😔隐忍克制，心里乱糟糟\n内心想法=一边在意对方，又害怕自己的情绪会吓到人\n阴暗面=想把对方牢牢攥在自己视线里，不希望别人靠近\n没说出口的话=其实我很怕你会慢慢疏远我\n想做的事=继续观察对方的态度，试探边界\n[/状态栏]"
}
{
  "type": "ai-phone-story-scheme",
  "version": 1,
  "kind": "status",
  "schemes": [
    {
      "name": "关系温度卡",
      "prompt": "在正文末尾输出 <story_status>，简洁记录当前时间、地点、关系温度和双方状态；内容会进入下一轮上下文。",
      "renderHtml": "<style>\n:root{--bg:#fff;--text:#334155;--sub:#94a3b8;--line:#e2e8f0}\n@media(prefers-color-scheme:dark){:root{--bg:#1c1c1e;--text:#e5e7eb;--sub:#94a3b8;--line:#334155}}\n*{box-sizing:border-box}body{margin:0;background:transparent;color:var(--text);font:13px/1.55 -apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif}\n.status{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:2px}\n.item{min-width:0;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}\n.key{display:block;color:var(--sub);font-size:10px;margin-bottom:2px}.value{display:block;overflow-wrap:anywhere;white-space:pre-wrap}\n</style>\n<div id=\"status\" class=\"status\"></div>\n<script>\nconst root=document.getElementById('status');\nconst rows=(window.STORY_RAW||'').split(/\\n+/).flatMap(line=>line.split(/\\s{2,}/)).map(v=>v.trim()).filter(Boolean);\nfor(const row of rows){const parts=row.split(/[｜|：:]/);const item=document.createElement('div');item.className='item';const key=document.createElement('span');key.className='key';key.textContent=parts.length>1?parts.shift().trim():'状态';const value=document.createElement('span');value.className='value';value.textContent=parts.join('｜').trim()||row;item.append(key,value);root.append(item)}\n</script>",
      "preview": "时间｜夜晚  地点｜窗边\n关系温度｜72%  状态｜靠近"
    },
    {
      "name": "奶黄手账状态栏",
      "prompt": "请在正文结束后，输出以下格式的剧情状态栏，必须严格包裹在 <story_status> 和 </story_status> 标签中，每行一个字段：\n\n<story_status>\n时间：[当前具体时间或时段与环境天气]\n地点：[Char与用户所处的具体空间位置]\n穿搭：[Char此刻的衣着装扮与细节]\n姿势：[Char此刻的身体动作、姿势或神态动作]\n心声：[Char此刻内心最深处最真实、羞涩、暗爽或吐槽的心理独白]\n叽叽状态：[Char此刻的生理/身体敏感反应、悸动状态或下意识生理小细节]\n小本本：[Char在心里暗戳戳记下的待办事项、小计划或小算盘，用数字序号列出1~3条]\n毛茸茸：[Char的动物塑形象与当前情绪拟态，如：垂耳金毛疯狂摇尾巴/被顺毛呼噜噜的咪咪/炸毛警惕的小黑猫等]\n</story_status>\n\n注意：只输出上述格式的纯文本键值对，无需输出 HTML 或额外解释。",
      "renderHtml": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --bg-creamy: #FFFDF5;\n    --bg-card: #FFF8E7;\n    --bg-accent: #FFEBB8;\n    --primary-yellow: #F6C445;\n    --deep-caramel: #8C5B23;\n    --text-main: #5C3D1E;\n    --text-muted: #8E7356;\n    --border-soft: #F0D9AA;\n    --white-trans: rgba(255, 255, 255, 0.85);\n    --shadow-soft: 0 4px 16px rgba(180, 130, 60, 0.08);\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg-creamy: #2A241C;\n      --bg-card: #342D23;\n      --bg-accent: #4A3E2D;\n      --primary-yellow: #E6B53A;\n      --deep-caramel: #F5D399;\n      --text-main: #F4ECE1;\n      --text-muted: #C4B29E;\n      --border-soft: #544633;\n      --white-trans: rgba(45, 38, 30, 0.85);\n      --shadow-soft: 0 4px 16px rgba(0, 0, 0, 0.3);\n    }\n  }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;\n    background: transparent;\n    padding: 10px 4px;\n    color: var(--text-main);\n    line-height: 1.5;\n  }\n  .cream-container {\n    background: var(--bg-card);\n    border: 2px solid var(--border-soft);\n    border-radius: 20px;\n    padding: 16px;\n    box-shadow: var(--shadow-soft);\n    position: relative;\n    overflow: hidden;\n  }\n  /* 顶部小耳朵/萌系装饰条 */\n  .cream-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 12px;\n    padding-bottom: 8px;\n    border-bottom: 1.5px dashed var(--border-soft);\n  }\n  .badge-tag {\n    background: var(--primary-yellow);\n    color: #4A2E00;\n    font-size: 11px;\n    font-weight: 700;\n    padding: 3px 10px;\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    box-shadow: 0 2px 6px rgba(246, 196, 69, 0.3);\n  }\n  .meta-pills {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    font-size: 12px;\n  }\n  .pill {\n    background: var(--white-trans);\n    border: 1px solid var(--border-soft);\n    padding: 2px 9px;\n    border-radius: 10px;\n    color: var(--text-muted);\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  /* 毛茸茸状态横幅（萌点高光） */\n  .fluffy-card {\n    background: linear-gradient(135deg, var(--bg-accent), var(--bg-card));\n    border: 1.5px solid var(--primary-yellow);\n    border-radius: 14px;\n    padding: 10px 12px;\n    margin-bottom: 12px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .fluffy-icon {\n    font-size: 24px;\n    background: var(--white-trans);\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    border: 1px solid var(--border-soft);\n  }\n  .fluffy-info {\n    flex: 1;\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--deep-caramel);\n  }\n\n  /* 双列网格 */\n  .grid-two {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 8px;\n    margin-bottom: 12px;\n  }\n  .info-box {\n    background: var(--white-trans);\n    border: 1px solid var(--border-soft);\n    border-radius: 12px;\n    padding: 8px 10px;\n    font-size: 12px;\n  }\n  .info-label {\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--deep-caramel);\n    margin-bottom: 3px;\n    display: flex;\n    align-items: center;\n    gap: 3px;\n  }\n  .info-val {\n    color: var(--text-main);\n    word-break: break-word;\n  }\n\n  /* 心声气泡 */\n  .heart-bubble {\n    background: var(--white-trans);\n    border-left: 4px solid var(--primary-yellow);\n    border-radius: 4px 12px 12px 4px;\n    padding: 8px 12px;\n    margin-bottom: 12px;\n    font-size: 12.5px;\n    position: relative;\n  }\n  .heart-label {\n    font-size: 11px;\n    font-weight: bold;\n    color: var(--deep-caramel);\n    margin-bottom: 2px;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .heart-text {\n    font-style: italic;\n    color: var(--text-main);\n  }\n\n  /* 叽叽状态与小本本 */\n  .note-section {\n    background: var(--white-trans);\n    border: 1.5px dashed var(--border-soft);\n    border-radius: 14px;\n    padding: 10px 12px;\n  }\n  .note-header {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--deep-caramel);\n    margin-bottom: 6px;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .note-item {\n    font-size: 12px;\n    color: var(--text-main);\n    line-height: 1.6;\n    padding-left: 4px;\n  }\n</style>\n</head>\n<body>\n<div class=\"cream-container\" id=\"app\">\n  <div class=\"cream-header\">\n    <div class=\"badge-tag\">🐾 STATUS NOTE</div>\n    <div class=\"meta-pills\">\n      <span class=\"pill\" id=\"time-pill\">🕒 <span id=\"val-time\">加载中...</span></span>\n      <span class=\"pill\" id=\"loc-pill\">📍 <span id=\"val-loc\">加载中...</span></span>\n    </div>\n  </div>\n\n  <div class=\"fluffy-card\" id=\"card-fluffy\">\n    <div class=\"fluffy-icon\">🐶</div>\n    <div class=\"fluffy-info\" id=\"val-fluffy\">毛茸茸动物塑状态...</div>\n  </div>\n\n  <div class=\"grid-two\">\n    <div class=\"info-box\">\n      <div class=\"info-label\">👗 穿搭细节</div>\n      <div class=\"info-val\" id=\"val-outfit\">-</div>\n    </div>\n    <div class=\"info-box\">\n      <div class=\"info-label\">🧘 姿势体态</div>\n      <div class=\"info-val\" id=\"val-pose\">-</div>\n    </div>\n  </div>\n\n  <div class=\"heart-bubble\">\n    <div class=\"heart-label\">💭 心声独白</div>\n    <div class=\"heart-text\" id=\"val-heart\">-</div>\n  </div>\n\n  <div class=\"info-box\" style=\"margin-bottom: 12px;\">\n    <div class=\"info-label\">⚡ 敏感/叽叽状态</div>\n    <div class=\"info-val\" id=\"val-status\">-</div>\n  </div>\n\n  <div class=\"note-section\">\n    <div class=\"note-header\">📒 秘密小本本 · 计划待办</div>\n    <div class=\"note-item\" id=\"val-plan\">-</div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const raw = window.STORY_RAW || `{{RAW}}` || '';\n  if (!raw.trim()) return;\n\n  const data = {};\n  const lines = raw.split(/\\r?\\n/);\n  \n  lines.forEach(line => {\n    const trimmed = line.trim();\n    if (!trimmed) return;\n    const colonIdx = trimmed.indexOf('：') !== -1 ? trimmed.indexOf('：') : trimmed.indexOf(':');\n    if (colonIdx !== -1) {\n      const key = trimmed.substring(0, colonIdx).trim().replace(/^[#*\\-•\\s]+/, '');\n      const val = trimmed.substring(colonIdx + 1).trim();\n      data[key] = val;\n    }\n  });\n\n  const get = (k, def='-') => {\n    for (let key in data) {\n      if (key.includes(k) || k.includes(key)) return data[key];\n    }\n    return def;\n  };\n\n  const timeVal = get('时间', '未知时间');\n  const locVal = get('地点', '未知地点');\n  const outfitVal = get('穿搭', '无特别描述');\n  const poseVal = get('姿势', '自然放松');\n  const heartVal = get('心声', '（心中泛起微微涟漪）');\n  const rawStatus = get('叽叽状态', get('叽叽', get('状态', '平静自然')));\n  const planVal = get('小本本', get('计划', '无特殊计划'));\n  const fluffyVal = get('毛茸茸', get('动物塑', '金毛摇尾巴'));\n\n  document.getElementById('val-time').textContent = timeVal;\n  document.getElementById('val-loc').textContent = locVal;\n  document.getElementById('val-outfit').textContent = outfitVal;\n  document.getElementById('val-pose').textContent = poseVal;\n  document.getElementById('val-heart').textContent = heartVal;\n  document.getElementById('val-status').textContent = rawStatus;\n  document.getElementById('val-fluffy').textContent = fluffyVal;\n\n  // 格式化计划列表\n  const planContainer = document.getElementById('val-plan');\n  if (planVal && planVal.includes('1.')) {\n    const items = planVal.split(/(?=\\d+[\\.、])/).filter(i => i.trim());\n    planContainer.innerHTML = items.map(it => `<div>📌 ${it.trim()}</div>`).join('');\n  } else {\n    planContainer.textContent = planVal;\n  }\n\n  // 动物头像自动匹配小趣味\n  const fluffyIcon = document.querySelector('.fluffy-icon');\n  if (fluffyVal.includes('狗') || fluffyVal.includes('汪') || fluffyVal.includes('金毛') || fluffyVal.includes('柴犬')) {\n    fluffyIcon.textContent = '🐶';\n  } else if (fluffyVal.includes('猫') || fluffyVal.includes('咪')) {\n    fluffyIcon.textContent = '🐱';\n  } else if (fluffyVal.includes('兔')) {\n    fluffyIcon.textContent = '🐰';\n  } else if (fluffyVal.includes('狐')) {\n    fluffyIcon.textContent = '🦊';\n  } else if (fluffyVal.includes('熊')) {\n    fluffyIcon.textContent = '🐻';\n  } else if (fluffyVal.includes('狼')) {\n    fluffyIcon.textContent = '🐺';\n  } else {\n    fluffyIcon.textContent = '🐾';\n  }\n})();\n</script>\n</body>\n</html>",
      "preview": "时间：周五 22:30 窗外微雨\n地点：主卧床边·暖黄地毯上\n穿搭：宽松米白棉质睡衣，领口微敞露出锁骨\n姿势：单膝曲起坐在地毯上，一手撑着下巴直勾勾仰头看你\n心声：（心跳快得要命……她靠得太近了，身上好香，能不能装作不经意抱一下？）\n叽叽状态：呼吸微滞，耳尖泛粉，视线慌乱下移又强行移开\n小本本：1. 今晚偷偷把睡衣扣子再解开一颗 2. 想办法骗她给顺顺毛 3. 明早做她最喜欢的厚蛋烧\n毛茸茸：金毛大狗疯狂摇尾巴，耳朵贴着脑袋一副乖巧讨摸摸的模样，内心小剧场已经开始原地转圈！"
    },
    {
      "name": "水色清透状态栏",
      "prompt": "请在正文结束后，输出以下格式的剧情状态栏，必须严格包裹在 <story_status> 和 </story_status> 标签中，每行一个字段：\n\n<story_status>\n时间：[当前具体时间或时段与天气]\n地点：[Char与用户所处的具体空间环境]\n好感度：[当前好感度百分比或数值与心动简评，如：88%（心跳过载·想更靠近你）]\n穿搭：[Char此刻的衣着穿搭与视觉细节]\n姿势：[Char此刻的身体动作、姿势与神态细节]\n心声：[Char此刻内心深处最真实的心理独白]\n叽叽状态：[Char此刻的生理/身体敏感反应、悸动状态或隐秘生理细节]\n小本本：[Char在心里暗自记下的计划或小算盘，用数字序号列出1~3条]\n毛茸茸：[Char的动物塑形象与当前情绪拟态]\n</story_status>\n\n注意：只输出上述格式的纯文本键值对，无需输出 HTML 或额外解释。",
      "renderHtml": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --aqua-bg: #F0F8FF;\n    --aqua-card: rgba(255, 255, 255, 0.75);\n    --aqua-card-inner: rgba(240, 248, 255, 0.85);\n    --aqua-primary: #38A3D8;\n    --aqua-primary-dark: #1E6B9B;\n    --aqua-deep: #164666;\n    --aqua-border: rgba(142, 202, 230, 0.45);\n    --aqua-glow: rgba(56, 163, 216, 0.18);\n    --text-title: #103B59;\n    --text-main: #244C66;\n    --text-muted: #5B829E;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --aqua-bg: #111E28;\n      --aqua-card: rgba(22, 38, 51, 0.8);\n      --aqua-card-inner: rgba(28, 48, 64, 0.85);\n      --aqua-primary: #52BCE8;\n      --aqua-primary-dark: #82D1F5;\n      --aqua-deep: #BBE1F5;\n      --aqua-border: rgba(82, 188, 232, 0.3);\n      --aqua-glow: rgba(82, 188, 232, 0.15);\n      --text-title: #E1F3FD;\n      --text-main: #CBE6F6;\n      --text-muted: #8AAEC4;\n    }\n  }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", sans-serif;\n    background: transparent;\n    padding: 10px 4px;\n    color: var(--text-main);\n    line-height: 1.5;\n  }\n  .aqua-container {\n    background: var(--aqua-card);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1.5px solid var(--aqua-border);\n    border-radius: 20px;\n    padding: 16px;\n    box-shadow: 0 8px 24px var(--aqua-glow), inset 0 1px 1px rgba(255,255,255,0.6);\n    position: relative;\n  }\n  /* 顶部水波装饰条与标签 */\n  .aqua-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 12px;\n    padding-bottom: 10px;\n    border-bottom: 1px solid var(--aqua-border);\n  }\n  .header-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: linear-gradient(135deg, var(--aqua-primary), #60C5F8);\n    color: #FFFFFF;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n    padding: 4px 12px;\n    border-radius: 20px;\n    box-shadow: 0 2px 8px var(--aqua-glow);\n  }\n  .meta-badges {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n  .meta-pill {\n    background: var(--aqua-card-inner);\n    border: 1px solid var(--aqua-border);\n    border-radius: 12px;\n    padding: 3px 10px;\n    font-size: 11.5px;\n    color: var(--text-muted);\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .svg-icon {\n    width: 13px;\n    height: 13px;\n    fill: currentColor;\n    flex-shrink: 0;\n  }\n\n  /* 好感度条水波卡片 */\n  .favor-section {\n    background: var(--aqua-card-inner);\n    border: 1px solid var(--aqua-border);\n    border-radius: 14px;\n    padding: 10px 12px;\n    margin-bottom: 12px;\n  }\n  .favor-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 6px;\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--text-title);\n  }\n  .favor-label {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .favor-progress-bg {\n    background: rgba(0, 0, 0, 0.06);\n    border-radius: 10px;\n    height: 7px;\n    overflow: hidden;\n    position: relative;\n  }\n  .favor-progress-fill {\n    background: linear-gradient(90deg, #60C5F8, var(--aqua-primary));\n    height: 100%;\n    width: 50%;\n    border-radius: 10px;\n    transition: width 0.6s ease;\n  }\n  .favor-desc {\n    font-size: 11.5px;\n    color: var(--text-muted);\n    margin-top: 5px;\n  }\n\n  /* 毛茸茸动物塑横幅 */\n  .fluffy-banner {\n    background: linear-gradient(135deg, rgba(82, 188, 232, 0.15), rgba(142, 202, 230, 0.08));\n    border: 1.5px solid var(--aqua-border);\n    border-radius: 14px;\n    padding: 9px 12px;\n    margin-bottom: 12px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .fluffy-icon-wrap {\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: var(--aqua-card-inner);\n    border: 1px solid var(--aqua-border);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--aqua-primary);\n    flex-shrink: 0;\n  }\n  .fluffy-text {\n    font-size: 12.5px;\n    font-weight: 600;\n    color: var(--aqua-deep);\n  }\n\n  /* 双列网格 */\n  .grid-2 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 8px;\n    margin-bottom: 12px;\n  }\n  .info-card {\n    background: var(--aqua-card-inner);\n    border: 1px solid var(--aqua-border);\n    border-radius: 12px;\n    padding: 8px 10px;\n  }\n  .card-title {\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--text-title);\n    margin-bottom: 3px;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .card-content {\n    font-size: 12px;\n    color: var(--text-main);\n    word-break: break-word;\n  }\n\n  /* 心声独白 */\n  .heart-box {\n    background: var(--aqua-card-inner);\n    border-left: 3.5px solid var(--aqua-primary);\n    border-radius: 4px 12px 12px 4px;\n    padding: 8px 12px;\n    margin-bottom: 12px;\n  }\n  .heart-title {\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--text-title);\n    margin-bottom: 2px;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .heart-val {\n    font-size: 12.5px;\n    font-style: italic;\n    color: var(--text-main);\n  }\n\n  /* 小本本计划清单 */\n  .notebook-box {\n    background: var(--aqua-card-inner);\n    border: 1.5px dashed var(--aqua-border);\n    border-radius: 14px;\n    padding: 10px 12px;\n  }\n  .notebook-header {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--text-title);\n    margin-bottom: 6px;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .notebook-list {\n    font-size: 12px;\n    color: var(--text-main);\n    line-height: 1.6;\n  }\n  .notebook-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 6px;\n    margin-bottom: 3px;\n  }\n  .dot-marker {\n    width: 5px;\n    height: 5px;\n    border-radius: 50%;\n    background: var(--aqua-primary);\n    margin-top: 6px;\n    flex-shrink: 0;\n  }\n</style>\n</head>\n<body>\n<div class=\"aqua-container\">\n  <!-- 顶部栏 -->\n  <div class=\"aqua-header\">\n    <div class=\"header-tag\">\n      <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"/></svg>\n      AQUA STATUS\n    </div>\n    <div class=\"meta-badges\">\n      <span class=\"meta-pill\">\n        <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14h-2v-2h2zm0-4h-2V7h2z\"/></svg>\n        <span id=\"v-time\">时间加载中...</span>\n      </span>\n      <span class=\"meta-pill\">\n        <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 2.5-2.5 2.5 2.5 0 0 1-2.5 2.5z\"/></svg>\n        <span id=\"v-loc\">地点加载中...</span>\n      </span>\n    </div>\n  </div>\n\n  <!-- 好感度波浪卡片 -->\n  <div class=\"favor-section\">\n    <div class=\"favor-header\">\n      <span class=\"favor-label\">\n        <svg class=\"svg-icon\" style=\"color:var(--aqua-primary);\" viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n        好感度共鸣\n      </span>\n      <span id=\"v-favor-num\" style=\"color:var(--aqua-primary); font-weight:800;\">--</span>\n    </div>\n    <div class=\"favor-progress-bg\">\n      <div class=\"favor-progress-fill\" id=\"v-favor-bar\"></div>\n    </div>\n    <div class=\"favor-desc\" id=\"v-favor-desc\">好感度评价加载中...</div>\n  </div>\n\n  <!-- 毛茸茸动物塑 -->\n  <div class=\"fluffy-banner\">\n    <div class=\"fluffy-icon-wrap\">\n      <svg class=\"svg-icon\" style=\"width:18px; height:18px;\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n    </div>\n    <div class=\"fluffy-text\" id=\"v-fluffy\">毛茸茸动物塑状态...</div>\n  </div>\n\n  <!-- 穿搭与姿势双列 -->\n  <div class=\"grid-2\">\n    <div class=\"info-card\">\n      <div class=\"card-title\">\n        <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M16 2l-4 4-4-4H4v6l4 2v12h8V10l4-2V2h-4z\"/></svg>\n        穿搭装扮\n      </div>\n      <div class=\"card-content\" id=\"v-outfit\">-</div>\n    </div>\n    <div class=\"info-card\">\n      <div class=\"card-title\">\n        <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 2a4 4 0 1 0 4 4 4 4 0 0 0-4-4zm-1 8c-3.31 0-6 2.69-6 6v4h2v-4a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v4h2v-4c0-3.31-2.69-6-6-6z\"/></svg>\n        身姿动魄\n      </div>\n      <div class=\"card-content\" id=\"v-pose\">-</div>\n    </div>\n  </div>\n\n  <!-- 心声独白 -->\n  <div class=\"heart-box\">\n    <div class=\"heart-title\">\n      <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z\"/></svg>\n      潜意识独白\n    </div>\n    <div class=\"heart-val\" id=\"v-heart\">-</div>\n  </div>\n\n  <!-- 叽叽状态 -->\n  <div class=\"info-card\" style=\"margin-bottom: 12px;\">\n    <div class=\"card-title\">\n      <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M7 2v11h3v9l7-12h-4l4-8z\"/></svg>\n      生理悸动 · 敏感状态\n    </div>\n    <div class=\"card-content\" id=\"v-status\">-</div>\n  </div>\n\n  <!-- 小本本计划 -->\n  <div class=\"notebook-box\">\n    <div class=\"notebook-header\">\n      <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z\"/></svg>\n      秘密规划 · 待办清单\n    </div>\n    <div class=\"notebook-list\" id=\"v-plan\">-</div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const raw = window.STORY_RAW || `{{RAW}}` || '';\n  if (!raw.trim()) return;\n\n  const data = {};\n  const lines = raw.split(/\\r?\\n/);\n  \n  lines.forEach(line => {\n    const trimmed = line.trim();\n    if (!trimmed) return;\n    const colonIdx = trimmed.indexOf('：') !== -1 ? trimmed.indexOf('：') : trimmed.indexOf(':');\n    if (colonIdx !== -1) {\n      const key = trimmed.substring(0, colonIdx).trim().replace(/^[#*\\-•\\s]+/, '');\n      const val = trimmed.substring(colonIdx + 1).trim();\n      data[key] = val;\n    }\n  });\n\n  const get = (k, def='-') => {\n    for (let key in data) {\n      if (key.includes(k) || k.includes(key)) return data[key];\n    }\n    return def;\n  };\n\n  const timeVal = get('时间', '夜幕低垂');\n  const locVal = get('地点', '静谧空间');\n  const outfitVal = get('穿搭', '优雅自然');\n  const poseVal = get('姿势', '自然微动');\n  const heartVal = get('心声', '（暗潮汹涌，目光深邃）');\n  const rawStatus = get('叽叽状态', get('叽叽', get('状态', '呼吸微滞，耳根微红')));\n  const planVal = get('小本本', get('计划', '无特殊规划'));\n  const fluffyVal = get('毛茸茸', get('动物塑', '水獭揣手手'));\n  const favorRaw = get('好感度', get('好感', '85%（心跳过载）'));\n\n  document.getElementById('v-time').textContent = timeVal;\n  document.getElementById('v-loc').textContent = locVal;\n  document.getElementById('v-outfit').textContent = outfitVal;\n  document.getElementById('v-pose').textContent = poseVal;\n  document.getElementById('v-heart').textContent = heartVal;\n  document.getElementById('v-status').textContent = rawStatus;\n  document.getElementById('v-fluffy').textContent = fluffyVal;\n\n  // 好感度解析\n  const matchNum = favorRaw.match(/(\\d+)%/);\n  let percent = 80;\n  if (matchNum) {\n    percent = parseInt(matchNum[1], 10);\n  }\n  document.getElementById('v-favor-num').textContent = percent + '%';\n  document.getElementById('v-favor-bar').style.width = Math.min(Math.max(percent, 5), 100) + '%';\n  document.getElementById('v-favor-desc').textContent = favorRaw;\n\n  // 计划列表\n  const planContainer = document.getElementById('v-plan');\n  if (planVal && planVal.includes('1.')) {\n    const items = planVal.split(/(?=\\d+[\\.、])/).filter(i => i.trim());\n    planContainer.innerHTML = items.map(it => `\n      <div class=\"notebook-item\">\n        <span class=\"dot-marker\"></span>\n        <span>${it.trim()}</span>\n      </div>\n    `).join('');\n  } else {\n    planContainer.textContent = planVal;\n  }\n})();\n</script>\n</body>\n</html>",
